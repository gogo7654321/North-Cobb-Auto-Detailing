{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "A detailing service reservation.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Customer name" },
        "phone": { "type": "string", "description": "Customer phone number" },
        "email": { "type": "string", "description": "Customer email" },
        "service": { "type": "string", "description": "Selected service (Exterior, Interior, Full)" },
        "price": { "type": "number", "description": "Service price" },
        "dateTime": { "type": "string", "format": "date-time", "description": "Booking slot date and time" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"], "description": "Booking status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "notes": { "type": "string", "description": "Optional notes or extra requests from physical customers" },
        "vehicleType": { "type": "string", "description": "Selected vehicle type (e.g. Sedan, SUV, Truck)" }
      },
      "required": ["name", "phone", "email", "service", "price", "dateTime", "status", "createdAt"]
    },
    "AdminConfig": {
      "title": "AdminConfig",
      "description": "Credentials and OAuth access tokens.",
      "type": "object",
      "properties": {
        "accessToken": { "type": "string", "description": "Google OAuth Access Token for APIs" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last token update time" },
        "email": { "type": "string", "description": "Owner email" }
      },
      "required": ["accessToken", "updatedAt", "email"]
    },
    "GalleryImage": {
      "title": "GalleryImage",
      "description": "A dynamic photo uploaded by the owner for showcase in the work gallery.",
      "type": "object",
      "properties": {
        "url": { "type": "string", "description": "Download URL of the images or Base64 encoding" },
        "name": { "type": "string", "description": "Original file name of the gallery item" },
        "caption": { "type": "string", "description": "Optional title or description for the photo" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Upload timestamp" },
        "storagePath": { "type": "string", "description": "Optional storage path if deleted from Storage" }
      },
      "required": ["url", "name", "createdAt"]
    },
    "BlockedSlot": {
      "title": "BlockedSlot",
      "description": "A time slot or an entire day blocked by the owner to prevent user bookings.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "description": "Date to block (YYYY-MM-DD)" },
        "timeSlot": { "type": "string", "description": "Time slot to block (09:00, 14:00, 18:00, 12:00, or all)" },
        "reason": { "type": "string", "description": "Optional reason for blocking" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Block creation timestamp" },
        "createdBy": { "type": "string", "description": "Owner email address" }
      },
      "required": ["date", "timeSlot", "createdAt", "createdBy"]
    }
  },
  "firestore": {
    "bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Reservations for vehicle detailing services."
    },
    "admin_config/{docId}": {
      "schema": "AdminConfig",
      "description": "Dynamic configurations and private tokens for backend dispatchers."
    },
    "gallery_images/{imageId}": {
      "schema": "GalleryImage",
      "description": "Dynamic pictures uploaded to show premium workmanship."
    },
    "authenticated_owners/{email}": {
      "schema": "AdminConfig",
      "description": "Records of logged-in authorized owner addresses and cache sessions."
    },
    "blocked_slots/{slotId}": {
      "schema": "BlockedSlot",
      "description": "Owner designated blocked-out dates and time slots."
    }
  }
}

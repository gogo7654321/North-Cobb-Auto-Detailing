rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /bookings/{bookingId} {
      allow read, write: if request.auth != null && 
                            (request.auth.token.email == "npatel012010@gmail.com" || request.auth.token.email == "northcobbdetailing@gmail.com");
      
      allow create: if request.resource.data.get('status', '') == 'pending' &&
                       request.resource.data.get('name', '') != '' &&
                       request.resource.data.get('phone', '') != '' &&
                       request.resource.data.get('email', '') != '' &&
                       request.resource.data.get('dateTime', '') != '' &&
                       request.resource.data.get('service', '') in ['Exterior Detail', 'Interior Detail', 'Full Detail'] &&
                       (
                         (request.resource.data.get('service', '') == 'Exterior Detail' && request.resource.data.get('price', 0) == 45) ||
                         (request.resource.data.get('service', '') == 'Interior Detail' && request.resource.data.get('price', 0) == 65) ||
                         (request.resource.data.get('service', '') == 'Full Detail' && request.resource.data.get('price', 0) == 100)
                       ) &&
                       (
                         request.resource.data.dateTime.size() < 16 ||
                         (
                           !exists(/databases/$(database)/documents/blocked_slots/$(request.resource.data.dateTime.substring(0, 10) + "_" + request.resource.data.dateTime.substring(11, 16))) &&
                           !exists(/databases/$(database)/documents/blocked_slots/$(request.resource.data.dateTime.substring(0, 10) + "_all"))
                         )
                       );
    }

    match /admin_config/{docId} {
      allow read, write: if request.auth != null && 
                            (request.auth.token.email == "npatel012010@gmail.com" || request.auth.token.email == "northcobbdetailing@gmail.com");
    }

    match /gallery_images/{imgId} {
      allow read: if true;
      allow write: if request.auth != null && 
                      (request.auth.token.email == "npatel012010@gmail.com" || request.auth.token.email == "northcobbdetailing@gmail.com");
    }

    match /authenticated_owners/{ownerId} {
      allow read: if true;
      allow write: if request.auth != null && 
                      (request.auth.token.email == "npatel012010@gmail.com" || request.auth.token.email == "northcobbdetailing@gmail.com");
    }

    match /blocked_slots/{slotId} {
      allow read: if true;
      allow write: if request.auth != null && 
                      (request.auth.token.email == "npatel012010@gmail.com" || request.auth.token.email == "northcobbdetailing@gmail.com");
    }
  }
}

    replacement_chunks {
      replacement_content: "import { useState } from \"react\";\n\ninterface GalleryItem {\n  src: string;\n  title: string;\n  category: \"Exterior\" | \"Interior\";\n  description: string;\n}\n\nexport default function WorkGallery() {\n  const [filter, setFilter] = useState<\"All\" | \"Exterior\" | \"Interior\">(\"All\");\n\n  const galleryItems: GalleryItem[] = [\n    {\n      src: \"/public/IMG_7813.jpeg\",\n      title: \"Surgical Deep Carpet & Floor Extraction\",\n      category: \"Interior\",\n      description: \"Our high-pressure deep extraction removes years of deeply embedded Georgia sand, road salt, and dirt from floor carpets.\"\n    },\n    {\n      src: \"/public/IMG_0663.jpeg\",\n      title: \"Mirror-Sheen Piano Black Polish\",\n      category: \"Exterior\",\n      description: \"Fine paint correction eliminating micro-scratches and swirl marks to restore a pure gloss mirror-finish to delicate glass trim.\"\n    },\n    {\n      src: \"/public/IMG_0648.jpeg\",\n      title: \"Showroom Reflection & Clear Coat Depth\",\n      category: \"Exterior\",\n      description: \"A single-stage precision hand polish that maximizes color contrast and clarity on standard and metallic paintwork.\"\n    },\n    {\n      src: \"/public/IMG_7812.jpeg\",\n      title: \"Hydrophobic Shell & Ultraviolet Armor\",\n      category: \"Exterior\",\n      description: \"Hand-applied resin wax that creates a resilient hydrophobic layer to bead away water and block Georgia summer rays.\"\n    },\n    {\n      src: \"/public/IMG_7815.jpeg\",\n      title: \"Clinical Alloy Wheel & Caliper Revital\",\n      category: \"Exterior\",\n      description: \"Delicate chemical break-up of baked-on brake dust, restoring a metallic sparkle to performance rims and tires.\"\n    },\n    {\n      src: \"/public/IMG_0659.jpeg\",\n      title: \"Pore-Cleansing Cabin Leather Preservation\",\n      category: \"Interior\",\n      description: \"Steam-assisted decontamination and nourishing conditioners that restore a high-class matte touch to cockpit leather.\"\n    }\n  ];\n\n  const filteredItems = filter === \"All\" \n    ? galleryItems \n    : galleryItems.filter(item => item.category === filter);\n\n  return (\n    <div className=\"space-y-8\">\n      {/* Section Introduction */}\n      <div className=\"flex flex-col md:flex-row items-baseline justify-between gap-4 border-b border-zinc-200 pb-5\">\n         <div className=\"text-left space-y-1\">\n          <span className=\"text-amber-800 font-bold text-xs uppercase tracking-widest block\">\n            Acworth \342\200\242 Kennesaw \342\200\242 Marietta \342\200\242 Cobb County\n          </span>\n          <h2 className=\"text-3xl sm:text-4xl font-serif font-bold text-zinc-900 tracking-tight\">\n            Our Detailing Showroom\n          </h2>\n          <p className=\"text-xs sm:text-sm text-zinc-500 font-medium\">\n            100% genuine results from actual driveway bookings. View real-world examples of our hand-wash precision.\n          </p>\n        </div>\n\n        {/* Categories toggler */}\n        <div className=\"flex flex-wrap gap-2 pt-2 md:pt-0\">\n          {([\"All\", \"Exterior\", \"Interior\"] as const).map((cat) => (\n            <button\n              key={cat}\n              onClick={() => setFilter(cat)}\n              className={`px-3 py-1.5 text-xs font-bold uppercase tracking-wider rounded-lg transition-all duration-200 cursor-pointer ${\n                filter === cat \n                  ? \"bg-[#b45309] text-white shadow-sm\" \n                  : \"bg-white border border-zinc-200 text-zinc-650 hover:text-zinc-900\"\n              }`}\n            >\n              {cat}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Grid displays - Clean & elegant showcase without popups */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n        {filteredItems.map((item, idx) => (\n          <div \n            key={idx}\n            className=\"group flex flex-col bg-white border border-zinc-200 rounded-2xl overflow-hidden transition-all duration-300 hover:border-[#b45309] hover:shadow-lg\"\n          >\n            {/* Image frame */}\n            <div className=\"aspect-[4/3] w-full overflow-hidden relative bg-zinc-50 border-b border-zinc-100\">\n              <img \n                src={item.src} \n                alt={item.title} \n                className=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]\" \n                referrerPolicy=\"no-referrer\"\n              />\n              <span className=\"absolute top-3 left-3 bg-white/95 border border-zinc-100 text-[9px] font-bold text-[#b45309] px-2.5 py-1 rounded-md shadow-sm uppercase tracking-wider\">\n                {item.category}\n              </span>\n            </div>\n\n            {/* Content text */}\n            <div className=\"p-6 text-left space-y-2 flex-grow flex flex-col justify-between\">\n              <div className=\"space-y-1.5\">\n                <h3 className=\"text-lg font-serif font-bold text-zinc-90 w-full tracking-tight text-zinc-900 leading-snug group-hover:text-[#b45309] transition-colors\">\n                  {item.title}\n                </h3>\n                <p className=\"text-xs text-zinc-600 leading-relaxed font-medium\">\n                  {item.description}\n                </p>\n              </div>\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n}\n"
    }

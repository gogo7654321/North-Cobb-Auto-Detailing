      replacement_content: "import { useState } from \"react\";\nimport { ArrowRight, Info } from \"lucide-react\";\nimport { DetailingService } from \"../types\";\n\nconst SERVICE_TIERS: DetailingService[] = [\n  {\n    name: \"Exterior Detail\",\n    price: 45,\n    duration: \"1 hour\",\n    description: \"Deep exterior hand wash with pH-balanced foam bath and premium microfiber mitts. Hand-dried cleanly with soft towels to guarantee a touch-free and scratch-free sheen. Tire and plastic dressings applied.\",\n    features: [\n      \"pH-neutral foam bath and soft hand contact wash\",\n      \"Wheels, tires, and wheel wells fully cleaned & dressed\",\n      \"Towel dried with soft premium microfiber material\",\n      \"Protective tire gloss and exterior plastic conditioners\"\n    ]\n  },\n  {\n    name: \"Interior Detail\",\n    price: 65,\n    duration: \"1.5 hours\",\n    description: \"Deep interior vacuuming of seats, carpets, cracks, and floor carpets. Scrubbing of door panels, console, dashboard, and weather mats. Windows cleaned to an crystal-clear streak-free shine.\",\n    features: [\n      \"Complete vacuuming of all seats, carpets, and trunk space\",\n      \"Scrubbing and dirt-lifting from dashboard, doors, and console\",\n      \"Deep cleaning of window glass both interior and exterior\",\n      \"Rubber weather mats washed and exhaustively scrubbed\"\n    ]\n  },\n  {\n    name: \"Full Detail\",\n    price: 100,\n    duration: \"Under 3 hours\",\n    description: \"Our complete bumper-to-bumper deep glaze and sanitization. Combines our premium interior and exterior packages into one seamless, showroom-level driveway transition.\",\n    features: [\n      \"Entire Exterior Hand Detail process with rim polish\",\n      \"Entire Interior Cabin Vacuum & Grooming package\",\n      \"Ultimate interior-exterior combination for a complete cabin reset\"\n    ]\n  }\n];\n\ninterface ServicesDetailProps {\n  onSelectService: (serviceName: string) => void;\n}\n\nexport default function ServicesDetail({ onSelectService }: ServicesDetailProps) {\n  const [activeMobileTab, setActiveMobileTab] = useState<number>(2); // Default to best-value (Full Detail)\n\n  return (\n    <div className=\"py-2 font-sans text-zinc-900 selection:bg-amber-100 selection:text-amber-900\">\n      \n      {/* Notice regarding vehicle size & dirtiness */}\n      <div className=\"mb-8 p-4 bg-amber-50/60 border border-amber-200/50 rounded-xl max-w-3xl mx-auto flex gap-3 text-left\">\n        <Info className=\"w-5 h-5 text-amber-800 shrink-0 mt-0.5\" />\n        <div>\n          <h4 className=\"text-xs font-bold text-amber-900 uppercase tracking-wider\">Estimated Pricing Guide</h4>\n          <p className=\"text-xs text-zinc-650 mt-0.5 font-medium leading-relaxed\">\n            All prices shown are estimated starting rates for compact vehicles in average condition. Actual pricing may vary depending on **vehicle size** (e.g., large SUVs, dually trucks, minivans) and **the level of dirtiness** (such as heavy pet hair, deep mud extraction, tree sap, or mold). Arthur and Carson will confirm the final quote in person upon reviewing your vehicle before starting!\n          </p>\n        </div>\n      </div>\n\n      {/* Mobile-Only Package Selector */}\n      <div className=\"lg:hidden max-w-sm mx-auto mb-6 bg-zinc-50 p-1 border border-zinc-200 flex gap-1 rounded-xl\">\n        {SERVICE_TIERS.map((service, index) => {\n          const isActive = activeMobileTab === index;\n          return (\n            <button\n              key={service.name}\n              type=\"button\"\n              onClick={() => setActiveMobileTab(index)}\n              className={`flex-1 text-center py-2.5 text-xs font-semibold uppercase tracking-wider transition-all duration-200 cursor-pointer rounded-lg ${\n                isActive\n                  ? \"bg-[#b45309] text-white shadow-sm\"\n                  : \"text-zinc-600 hover:text-zinc-900\"\n              }`}\n            >\n              <div className=\"text-[9px] opacity-80\">${service.price}*</div>\n              <span className=\"block truncate\">{service.name.split(\" \")[0]}</span>\n            </button>\n          );\n        })}\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch\">\n        {SERVICE_TIERS.map((service, index) => {\n          const isFullDetail = service.name === \"Full Detail\";\n          const isInterior = service.name === \"Interior Detail\";\n          const isActiveOnMobile = activeMobileTab === index;\n          \n          return (\n            <div\n              id={`service_tier_card_${index}`}\n              key={service.name}\n              className={`relative flex flex-col justify-between overflow-hidden bg-white border transition-all duration-200 hover:shadow-md rounded-2xl ${\n                isActiveOnMobile ? \"flex\" : \"hidden lg:flex\"\n              } ${\n                isFullDetail\n                  ? \"ring-2 ring-[#b45309]/25 border-[#b45309] bg-[#fffdfa]/50\"\n                  : \"border-zinc-200\"\n              }`}\n            >\n              {/* Duration Badge */}\n              <div className=\"absolute top-3 right-3 bg-zinc-100 text-zinc-700 text-[10px] font-bold px-2.5 py-1 rounded-md\">\n                {service.duration}\n              </div>\n\n              {/* Service Content Container */}\n              <div className=\"p-6 sm:p-8 pt-8 text-left\">\n                {isFullDetail && (\n                  <div className=\"inline-block mb-3 bg-amber-50 text-amber-800 text-[10px] font-bold tracking-wider px-2.5 py-0.5 rounded-md border border-amber-200/50 uppercase\">\n                    Best Value Package\n                  </div>\n                )}\n                {isInterior && (\n                  <div className=\"inline-block mb-3 bg-zinc-100 text-zinc-700 text-[10px] font-bold tracking-wider px-2.5 py-0.5 rounded-md border border-zinc-200 uppercase\">\n                    Deep Cabin Refresh\n                  </div>\n                )}\n                {!isFullDetail && !isInterior && (\n                  <div className=\"inline-block mb-3 bg-[#faf5f0] text-zinc-700 text-[10px] font-bold tracking-wider px-2.5 py-0.5 rounded-md border border-zinc-200 uppercase\">\n                    Gloss Finish\n                  </div>\n                )}\n\n                <h4 className=\"text-2xl font-serif font-bold text-zinc-900 tracking-tight mb-1\">\n                  {service.name}\n                </h4>\n                \n                <div className=\"flex items-baseline gap-1.5 mb-2\">\n                  <span className=\"text-3xl font-extrabold text-[#b45309]\">\n                    ${service.price}*\n                  </span>\n                  <span className=\"text-[10px] text-zinc-500 font-bold uppercase tracking-wide\">\n                    starting estimate\n                  </span>\n                </div>\n\n                <div className=\"h-[1px] bg-zinc-100 my-4\" />\n\n                <p className=\"text-zinc-600 text-xs sm:text-sm leading-relaxed mb-6 font-medium\">\n                  {service.description}\n                </p>\n\n                {/* Bullet-point section */}\n                <div className=\"space-y-3\">\n                  <span className=\"text-[10px] font-bold tracking-wider uppercase text-zinc-400 block\">\n                    What\'s Included:\n                  </span>\n                  <ul className=\"space-y-2.5\">\n                    {service.features.map((feature, fIndex) => (\n                      <li key={fIndex} className=\"flex items-start gap-2\">\n                        <span className=\"text-[#b45309] font-bold text-xs select-none mt-0.5\">\342\200\242</span>\n                        <span className=\"text-zinc-700 text-xs sm:text-sm font-semibold leading-relaxed\">\n                          {feature}\n                        </span>\n                      </li>\n                    ))}\n                  </ul>\n                </div>\n              </div>\n\n              {/* Card Footer Button Container */}\n              <div className=\"p-6 bg-zinc-50/50 border-t border-zinc-150 mt-auto\">\n                <button\n                  id={`book_button_${service.name.toLowerCase().replace(\" \", \"_\")}`}\n                  onClick={() => onSelectService(service.name)}\n                  className={`w-full py-3 px-4 font-bold text-xs tracking-wider uppercase transition-all duration-250 flex items-center justify-center gap-2 rounded-xl cursor-pointer ${\n                    isFullDetail\n                      ? \"bg-[#b45309] text-white hover:bg-[#9a3412] hover:shadow-sm\"\n                      : \"bg-zinc-900 text-white hover:bg-black\"\n                  }`}\n                >\n                  Request {service.name}\n                  <ArrowRight className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n}\n"
    }

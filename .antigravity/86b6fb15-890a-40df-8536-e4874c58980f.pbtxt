  file_change {
    absolute_path_uri: "file:///src/components/BookingForm.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState, useEffect } from \"react\";\nimport { db } from \"../lib/firebase\";\nimport { collection, addDoc } from \"firebase/firestore\";\nimport { BookingServiceType, Booking } from \"../types\";\nimport { Calendar, Clock, CheckCircle2, ChevronRight, AlertTriangle, Loader2 } from \"lucide-react\";\nimport { motion, AnimatePresence } from \"motion/react\";\n\ninterface BookingFormProps {\n  initialService?: string;\n}\n\nconst SERVICE_PRICES = {\n  \"Exterior Detail\": 45,\n  \"Interior Detail\": 65,\n  \"Full Detail\": 100\n};\n\nexport default function BookingForm({ initialService }: BookingFormProps) {\n  // Booking Fields State\n  const [name, setName] = useState(\"\");\n  const [phone, setPhone] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [service, setService] = useState<BookingServiceType>(\"Full Detail\");\n  const [vehicleType, setVehicleType] = useState(\"\");\n  const [notes, setNotes] = useState(\"\");\n  \n  // Date and Time slot State\n  const [chosenDate, setChosenDate] = useState(\"\");\n  const [chosenTime, setChosenTime] = useState(\"10:00\"); // Default 10:00 AM\n  \n  // Status and Validation states\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n  const [bookingRef, setBookingRef] = useState<string | null>(null);\n\n  // Set initial service if passed from app navigation selection\n  useEffect(() => {\n    if (initialService) {\n      const formatted = initialService.trim() as BookingServiceType;\n      if (SERVICE_PRICES[formatted]) {\n        setService(formatted);\n      }\n    }\n  }, [initialService]);\n\n  // Set default date to tomorrow\n  useEffect(() => {\n    const tomorrow = new Date();\n    tomorrow.setDate(tomorrow.getDate() + 1);\n    const yyyy = tomorrow.getFullYear();\n    const mm = String(tomorrow.getMonth() + 1).padStart(2, \"0\");\n    const dd = String(tomorrow.getDate()).padStart(2, \"0\");\n    setChosenDate(`${yyyy}-${mm}-${dd}`);\n  }, []);\n\n  const availableSlots = [\n    { value: \"09:00\", label: \"9:00 AM\" },\n    { value: \"10:00\", label: \"10:00 AM\" },\n    { value: \"11:00\", label: \"11:00 AM\" },\n    { value: \"12:00\", label: \"12:00 PM\" },\n    { value: \"13:00\", label: \"1:00 PM\" },\n    { value: \"14:00\", label: \"2:00 PM\" },\n    { value: \"15:00\", label: \"3:00 PM\" },\n    { value: \"16:00\", label: \"4:00 PM\" },\n    { value: \"17:00\", label: \"5:00 PM\" }\n  ];\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(null);\n\n    if (!name.trim()) return setErrorMsg(\"Please provide your name.\");\n    if (!phone.trim()) return setErrorMsg(\"Please provide a phone number.\");\n    if (!email.trim() || !email.includes(\"@\")) return setErrorMsg(\"A valid email address is required.\");\n    if (!chosenDate) return setErrorMsg(\"Please select a booking day.\");\n    if (!vehicleType.trim()) return setErrorMsg(\"Please enter your vehicle type (e.g. SUV, Sedan).\");\n\n    const todayStr = new Date().toISOString().split(\"T\")[0];\n    if (chosenDate < todayStr) {\n      return setErrorMsg(\"Please select a future date.\");\n    }\n\n    const hourInt = parseInt(chosenTime.split(\":\")[0], 10);\n    if (hourInt < 9 || hourInt > 18) {\n      return setErrorMsg(\"Detailing hours are strictly between 9:00 AM and 6:00 PM.\");\n    }\n\n    setIsSubmitting(true);\n\n    try {\n      const dateTimeString = `${chosenDate}T${chosenTime}:00`;\n      \n      const newBooking: Booking = {\n        name: name.trim(),\n        phone: phone.trim(),\n        email: email.trim().toLowerCase(),\n        service,\n        price: SERVICE_PRICES[service],\n        dateTime: dateTimeString,\n        status: \"pending\",\n        createdAt: new Date().toISOString(),\n        notes: notes.trim() || \"\",\n        vehicleType: vehicleType.trim()\n      };\n\n      const docRef = await addDoc(collection(db, \"bookings\"), newBooking);\n      console.log(\"[BookingForm] Auto-saved to Firestore doc ID: \", docRef.id);\n\n      // Notify alerts channel proxy\n      try {\n        await fetch(\"/api/cloud-functions-booking\", {\n          method: \"POST\",\n          headers: {\n            \"Content-Type\": \"application/json\"\n          },\n          body: JSON.stringify({ bookingId: docRef.id })\n        });\n      } catch (pipelineErr) {\n        console.error(\"[BookingForm] Warning: Alert function failed silently: \", pipelineErr);\n      }\n\n      setBookingRef(docRef.id);\n      \n      // Reset inputs\n      setName(\"\");\n      setPhone(\"\");\n      setEmail(\"\");\n      setVehicleType(\"\");\n      setNotes(\"\");\n\n    } catch (err: any) {\n      console.error(\"[BookingForm] Error submitting:\", err);\n      setErrorMsg(err.message || \"Failed to submit request.\");\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  return (\n    <AnimatePresence mode=\"wait\">\n      {bookingRef ? (\n        <motion.div\n          key=\"success-card\"\n          initial={{ opacity: 0, scale: 0.95, y: 10 }}\n          animate={{ opacity: 1, scale: 1, y: 0 }}\n          exit={{ opacity: 0, scale: 0.95, y: -10 }}\n          transition={{ duration: 0.3, ease: \"easeOut\" }}\n          className=\"bg-white border border-emerald-500/20 p-6 sm:p-8 text-center space-y-6 rounded-2xl\"\n        >\n          <div className=\"w-14 h-14 rounded-full bg-emerald-50 border border-emerald-500/30 text-emerald-600 flex items-center justify-center mx-auto shadow-sm\">\n            <CheckCircle2 className=\"w-7 h-7\" />\n          </div>\n\n          <div className=\"space-y-1\">\n            <h4 className=\"text-lg font-serif font-bold text-zinc-900\">\n              Request Pending Confirmation\n            </h4>\n            <span className=\"text-[10px] font-bold uppercase tracking-wider text-amber-800 bg-amber-50 px-2.5 py-1 rounded-md inline-block\">\n              Ref ID: {bookingRef.substring(0, 8).toUpperCase()}\n            </span>\n            <p className=\"text-xs text-zinc-650 max-w-sm mx-auto leading-relaxed pt-2\">\n              Our detailing crew has been instantly notified. We will review our schedule for {chosenDate} and send a text or email confirmation shortly!\n            </p>\n          </div>\n\n          <div className=\"p-4 bg-zinc-50 border border-zinc-200/60 rounded-xl text-left text-xs space-y-2\">\n            <div className=\"flex justify-between font-medium text-zinc-500\">\n              <span>Package Selected:</span>\n              <span className=\"text-zinc-900 font-semibold\">{service}</span>\n            </div>\n            <div className=\"flex justify-between font-medium text-zinc-500\">\n              <span>Estimated Base:*</span>\n              <span className=\"text-zinc-900 font-semibold\">${SERVICE_PRICES[service]}*</span>\n            </div>\n            <div className=\"flex justify-between font-medium text-zinc-500\">\n              <span>Proposed Time:</span>\n              <span className=\"text-zinc-900 font-semibold\">\n                {chosenDate} @ {availableSlots.find(s => s.value === chosenTime)?.label || chosenTime}\n              </span>\n            </div>\n          </div>\n          \n          <p className=\"text-[10px] text-zinc-400 text-left leading-relaxed\">\n            * Note: This is an estimated starting price based on a standard vehicle size and normal condition. Total price may vary model-to-model depending on size and dirtyness.\n          </p>\n\n          <button\n            onClick={() => setBookingRef(null)}\n            className=\"w-full py-3 bg-zinc-900 text-white hover:bg-black font-semibold text-xs uppercase tracking-widest transition-colors cursor-pointer rounded-xl\"\n          >\n            Book Another Session\n          </button>\n        </motion.div>\n      ) : (\n        <motion.form\n          key=\"booking-form\"\n          initial={{ opacity: 0 }}\n          animate={{ opacity: 1 }}\n          exit={{ opacity: 0 }}\n          onSubmit={handleSubmit}\n          className=\"space-y-4 text-left text-xs text-zinc-900 font-sans\"\n        >\n          <AnimatePresence>\n            {errorMsg && (\n              <motion.div\n                initial={{ opacity: 0, y: -10 }}\n                animate={{ opacity: 1, y: 0 }}\n                exit={{ opacity: 0, y: -10 }}\n                className=\"bg-rose-50 border border-rose-100 p-3 flex items-start gap-2 text-rose-800 rounded-lg\"\n              >\n                <AlertTriangle className=\"w-4 h-4 shrink-0 text-rose-600 mt-0.5\" />\n                <span className=\"font-semibold\">{errorMsg}</span>\n              </motion.div>\n            )}\n          </AnimatePresence>\n\n          {/* service selection */}\n          <div className=\"space-y-1.5\">\n            <label className=\"text-xs font-bold text-zinc-700 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1\">\n              <span>Choose Detailing Package *</span>\n              <span className=\"text-xs text-[#b45309] font-extrabold\">Est. Starting at ${SERVICE_PRICES[service]}*</span>\n            </label>\n            <p className=\"text-[10px] text-zinc-450 leading-relaxed font-medium\">\n              * Base estimates only. Final pricing depends on actual vehicle size and condition/dirtiness.\n            </p>\n            <div className=\"grid grid-cols-3 gap-2\">\n              {(Object.keys(SERVICE_PRICES) as BookingServiceType[]).map((tier) => {\n                const isSelected = service === tier;\n                return (\n                  <button\n                    key={tier}\n                    type=\"button\"\n                    onClick={() => setService(tier)}\n                    className={`py-3 px-2 border text-center transition-all duration-150 cursor-pointer rounded-lg ${\n                      isSelected \n                        ? \"bg-amber-50/50 border-[#b45309] text-[#b45309] font-semibold\" \n                        : \"bg-white border-zinc-200 text-zinc-600 hover:text-zinc-900\"\n                    }`}\n                  >\n                    <div className=\"text-sm font-extrabold text-zinc-900\">${SERVICE_PRICES[tier]}*</div>\n                    <span className=\"block mt-0.5 text-[9px] uppercase tracking-wider font-bold\">{tier.replace(\" Detail\", \"\")}</span>\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            {/* client Name */}\n            <div className=\"space-y-1\">\n              <label htmlFor=\"client_name\" className=\"text-xs font-bold text-zinc-700 block\">Your Name *</label>\n              <input\n                id=\"client_name\"\n                type=\"text\"\n                required\n                placeholder=\"John Doe\"\n                value={name}\n                onChange={(e) => setName(e.target.value)}\n                disabled={isSubmitting}\n                className=\"w-full bg-white border border-zinc-200 focus:border-[#b45309] focus:ring-1 focus:ring-[#b45309]/20 px-3.5 py-2.5 rounded-lg transition-all text-xs font-semibold focus:outline-none\"\n              />\n            </div>\n\n            {/* vehicle type */}\n            <div className=\"space-y-1\">\n              <label htmlFor=\"vehicle_spec\" className=\"text-xs font-bold text-zinc-700 block\">Vehicle Type *</label>\n              <input\n                id=\"vehicle_spec\"\n                type=\"text\"\n                required\n                placeholder=\"e.g. SUV, Sedan, Truck, Minivan\"\n                value={vehicleType}\n                onChange={(e) => setVehicleType(e.target.value)}\n                disabled={isSubmitting}\n                className=\"w-full bg-white border border-zinc-200 focus:border-[#b45309] focus:ring-1 focus:ring-[#b45309]/20 px-3.5 py-2.5 rounded-lg transition-all text-xs font-semibold focus:outline-none\"\n              />\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            {/* Contact Phone */}\n            <div className=\"space-y-1\">\n              <label htmlFor=\"phone_number\" className=\"text-xs font-bold text-zinc-700 block\">Contact Phone *</label>\n              <input\n                id=\"phone_number\"\n                type=\"tel\"\n                required\n                placeholder=\"(404) 555-0199\"\n                value={phone}\n                onChange={(e) => setPhone(e.target.value)}\n                disabled={isSubmitting}\n                className=\"w-full bg-white border border-zinc-200 focus:border-[#b45309] focus:ring-1 focus:ring-[#b45309]/20 px-3.5 py-2.5 rounded-lg transition-all text-xs font-semibold focus:outline-none\"\n              />\n            </div>\n\n            {/* Email */}\n            <div className=\"space-y-1\">\n              <label htmlFor=\"email_address\" className=\"text-xs font-bold text-zinc-700 block\">Email Address *</label>\n              <input\n                id=\"email_address\"\n                type=\"email\"\n                required\n                placeholder=\"johndoe@gmail.com\"\n                value={email}\n                onChange={(e) => setEmail(e.target.value)}\n                disabled={isSubmitting}\n                className=\"w-full bg-white border border-zinc-200 focus:border-[#b45309] focus:ring-1 focus:ring-[#b45309]/20 px-3.5 py-2.5 rounded-lg transition-all text-xs font-semibold focus:outline-none\"\n              />\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            {/* Preferred Date */}\n            <div className=\"space-y-1\">\n              <label htmlFor=\"preferred_date\" className=\"text-xs font-bold text-zinc-700 block flex items-center justify-between\">\n                <span>Preferred Date *</span>\n              </label>\n              <input\n                id=\"preferred_date\"\n                type=\"date\"\n                required\n                value={chosenDate}\n                onChange={(e) => setChosenDate(e.target.value)}\n                disabled={isSubmitting}\n                className=\"w-full bg-white border border-zinc-200 focus:border-[#b45309] focus:ring-1 focus:ring-[#b45309]/20 px-3.5 py-2.5 rounded-lg transition-all text-xs font-semibold focus:outline-none\"\n              />\n            </div>\n\n            {/* Ideal hours */}\n            <div className=\"space-y-1\">\n              <label htmlFor=\"preferred_time_slot\" className=\"text-xs font-bold text-zinc-700 block flex items-center justify-between\">\n                <span>Preferred Time Period *</span>\n              </label>\n              <select\n                id=\"preferred_time_slot\"\n                value={chosenTime}\n                onChange={(e) => setChosenTime(e.target.value)}\n                disabled={isSubmitting}\n                className=\"w-full bg-white border border-zinc-200 focus:border-[#b45309] focus:ring-1 focus:ring-[#b45309]/20 px-3.5 py-2.5 rounded-lg transition-all text-xs font-semibold focus:outline-none cursor-pointer\"\n              >\n                {availableSlots.map((slot) => (\n                  <option key={slot.value} value={slot.value}>\n                    {slot.label} \342\200\224 Crews On-Site\n                  </option>\n                ))}\n              </select>\n            </div>\n          </div>\n\n          {/* special requests */}\n          <div className=\"space-y-1\">\n            <label htmlFor=\"notes_requests\" className=\"text-xs font-bold text-zinc-700 block\">Driveway Access & Special Requests</label>\n            <textarea\n              id=\"notes_requests\"\n              rows={2}\n              placeholder=\"e.g. Garden spigot is located at the side of the house...\"\n              value={notes}\n              onChange={(e) => setNotes(e.target.value)}\n              disabled={isSubmitting}\n              className=\"w-full bg-white border border-zinc-200 focus:border-[#b45309] focus:ring-1 focus:ring-[#b45309]/20 px-3.5 py-2.5 rounded-lg transition-all text-xs font-semibold focus:outline-none resize-none\"\n            />\n          </div>\n\n          <button\n            type=\"submit\"\n            disabled={isSubmitting}\n            className=\"w-full py-3.5 bg-[#b45309] hover:bg-[#9a3412] disabled:bg-zinc-300 text-white font-bold text-xs uppercase tracking-widest transition-all mt-2 flex items-center justify-center gap-1.5 shadow-sm rounded-lg cursor-pointer\"\n          >\n            {isSubmitting ? (\n              <>\n                <Loader2 className=\"w-4 h-4 animate-spin\" />\n                Scheduling reservation...\n              </>\n            ) : (\n              <>\n                Reserve Driveway Booking\n                <ChevronRight className=\"w-4 h-4 text-white\" />\n              </>\n            )}\n          </button>\n\n          <span className=\"block text-[10px] text-center text-zinc-500 font-semibold mt-1\">\n            No payment required upfront \342\200\242 Inspect your car before you pay\n          </span>\n        </motion.form>\n      )}\n    </AnimatePresence>\n  );\n}\n"

  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState, useEffect } from \"react\";\nimport { \n  MapPin, \n  PhoneCall, \n  Menu, \n  X, \n  Star, \n  Check, \n  ArrowRight\n} from \"lucide-react\";\nimport WorkGallery from \"./components/WorkGallery\";\nimport ServicesDetail from \"./components/ServicesDetail\";\nimport BookingForm from \"./components/BookingForm\";\nimport AdminPortal from \"./components/AdminPortal\";\n\nexport default function App() {\n  const [selectedTab, setSelectedTab] = useState<\"home\" | \"services\" | \"gallery\" | \"book\" | \"owner\">(\"home\");\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n  const [passedService, setPassedService] = useState<string>(\"\");\n\n  // Hash routing\n  useEffect(() => {\n    const handleHashChange = () => {\n      const hash = window.location.hash;\n      if (hash === \"#owner-portal\") {\n        setSelectedTab(\"owner\");\n      } else if (hash === \"#services\") {\n        setSelectedTab(\"services\");\n      } else if (hash === \"#gallery\") {\n        setSelectedTab(\"gallery\");\n      } else if (hash === \"#book\") {\n        setSelectedTab(\"book\");\n      } else {\n        setSelectedTab(\"home\");\n      }\n    };\n\n    handleHashChange();\n    window.addEventListener(\"hashchange\", handleHashChange);\n    return () => window.removeEventListener(\"hashchange\", handleHashChange);\n  }, []);\n\n  const scrollToBookingAndSelect = (serviceName: string) => {\n    setPassedService(serviceName);\n    setSelectedTab(\"book\");\n    window.location.hash = \"#book\";\n    setMobileMenuOpen(false);\n    \n    setTimeout(() => {\n      const element = document.getElementById(\"booking_section_view\");\n      if (element) {\n        element.scrollIntoView({ behavior: \"smooth\" });\n      }\n    }, 120);\n  };\n\n  const isOwner = selectedTab === \"owner\";\n\n  return (\n    <div className=\"min-h-screen font-sans antialiased bg-white text-zinc-900 selection:bg-amber-100 selection:text-amber-900 pb-24 md:pb-0\">\n      \n      {/* Background texture line overlay */}\n      <div className=\"absolute inset-0 pointer-events-none opacity-[0.02]\" \n        style={{\n          backgroundImage: `radial-gradient(#000 1px, transparent 1px)`,\n          backgroundSize: \'24px 24px\'\n        }} \n      />\n\n      {/* TOP HEADER */}\n      <header className=\"sticky top-0 z-40 backdrop-blur-md border-b bg-white/95 border-zinc-200\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between\">\n          \n          {/* Logo brand */}\n          <div \n            id=\"brand_logo_link\"\n            onClick={() => { setSelectedTab(\"home\"); window.location.hash = \"\"; }} \n            className=\"flex items-center gap-3 cursor-pointer select-none group\"\n          >\n            <div className=\"w-12 h-12 flex items-center justify-center border border-zinc-200 bg-white group-hover:border-[#b45309] overflow-hidden p-1 rounded-xl transition-all\">\n              <img \n                src=\"/North_CObb_Detailing.PNG\" \n                alt=\"North Cobb Detailing Logo\" \n                className=\"w-full h-full object-contain\" \n                referrerPolicy=\"no-referrer\"\n              />\n            </div>\n            <div>\n              <h1 className=\"text-sm font-sans font-extrabold tracking-wider text-zinc-90 w-full text-zinc-900 group-hover:text-[#b45309] transition-colors uppercase\">\n                North Cobb <span className=\"text-[#b45309]\">Detailing</span>\n              </h1>\n              <span className=\"text-[9px] font-bold block text-zinc-500 uppercase tracking-widest leading-none mt-1\">\n                Premium Driveway Wash \342\200\242 Est. Pricing\n              </span>\n            </div>\n          </div>\n\n          {/* Navigation Links */}\n          <nav className=\"hidden md:flex items-center gap-6\">\n            <button\n              id=\"nav_link_home\"\n              onClick={() => { setSelectedTab(\"home\"); setPassedService(\"\"); window.location.hash = \"\"; }}\n              className={`text-xs font-bold uppercase tracking-widest px-3 py-2 cursor-pointer transition-colors relative ${\n                selectedTab === \"home\" \n                  ? \"text-[#b45309] border-b-2 border-[#b45309]\" \n                  : \"text-zinc-650 hover:text-zinc-900\"\n              }`}\n            >\n              Overview\n            </button>\n            <button\n              id=\"nav_link_services\"\n              onClick={() => { setSelectedTab(\"services\"); window.location.hash = \"#services\"; }}\n              className={`text-xs font-bold uppercase tracking-widest px-3 py-2 cursor-pointer transition-colors relative ${\n                selectedTab === \"services\" \n                  ? \"text-[#b45309] border-b-2 border-[#b45309]\" \n                  : \"text-zinc-650 hover:text-zinc-900\"\n              }`}\n            >\n              Services\n            </button>\n            <button\n              id=\"nav_link_gallery\"\n              onClick={() => { setSelectedTab(\"gallery\"); window.location.hash = \"#gallery\"; }}\n              className={`text-xs font-bold uppercase tracking-widest px-3 py-2 cursor-pointer transition-colors relative ${\n                selectedTab === \"gallery\" \n                  ? \"text-[#b45309] border-b-2 border-[#b45309]\" \n                  : \"text-zinc-650 hover:text-zinc-900\"\n              }`}\n            >\n              Work Gallery\n            </button>\n            <button\n              id=\"nav_link_book\"\n              onClick={() => { setSelectedTab(\"book\"); setPassedService(\"\"); window.location.hash = \"#book\"; }}\n              className={`text-xs font-bold uppercase tracking-widest px-4 py-2 cursor-pointer transition-all relative rounded-lg border ${\n                selectedTab === \"book\" \n                  ? \"text-white bg-[#b45309] border-[#b45309]\" \n                  : \"text-zinc-700 bg-zinc-50 hover:bg-zinc-100 border-zinc-200\"\n              }`}\n            >\n              Request Spot\n            </button>\n          </nav>\n\n          {/* Mobile Quick Action Buttons */}\n          <div className=\"flex items-center gap-2 md:hidden\">\n            <a\n              id=\"mobile_quick_call_btn\"\n              href=\"tel:+12087707517\"\n              className=\"p-2 border border-zinc-200 text-[#b45309] hover:bg-zinc-50 rounded-lg flex items-center justify-center bg-white\"\n              title=\"Call Detailing Crew\"\n            >\n              <PhoneCall className=\"w-4 h-4\" />\n            </a>\n            \n            <button\n              id=\"mobile_hamburger_btn\"\n              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n              className=\"p-2 rounded-lg border border-zinc-200 text-zinc-700 hover:bg-zinc-50 bg-white flex items-center justify-center\"\n            >\n              {mobileMenuOpen ? <X className=\"w-4 h-4\" /> : <Menu className=\"w-4 h-4\" />}\n            </button>\n          </div>\n        </div>\n\n        {/* Mobile Navigation Dropdown */}\n        {mobileMenuOpen && (\n          <div className=\"md:hidden border-b-2 py-4 px-6 space-y-2 bg-white border-zinc-100 animate-in fade-in duration-100\">\n            <button\n              id=\"mob_nav_link_home\"\n              onClick={() => { setSelectedTab(\"home\"); setMobileMenuOpen(false); setPassedService(\"\"); window.location.hash = \"\"; }}\n              className={`w-full text-left font-bold text-xs uppercase tracking-wider block py-2 px-3 rounded-lg ${\n                selectedTab === \"home\" ? \"bg-amber-50 text-amber-900\" : \"text-zinc-600\"\n              }`}\n            >\n              Overview\n            </button>\n            <button\n              id=\"mob_nav_link_services\"\n              onClick={() => { setSelectedTab(\"services\"); setMobileMenuOpen(false); window.location.hash = \"#services\"; }}\n              className={`w-full text-left font-bold text-xs uppercase tracking-wider block py-2 px-3 rounded-lg ${\n                selectedTab === \"services\" ? \"bg-amber-50 text-amber-900\" : \"text-zinc-600\"\n              }`}\n            >\n              Services\n            </button>\n            <button\n              id=\"mob_nav_link_gallery\"\n              onClick={() => { setSelectedTab(\"gallery\"); setMobileMenuOpen(false); window.location.hash = \"#gallery\"; }}\n              className={`w-full text-left font-bold text-xs uppercase tracking-wider block py-2 px-3 rounded-lg ${\n                selectedTab === \"gallery\" ? \"bg-amber-50 text-amber-900\" : \"text-zinc-600\"\n              }`}\n            >\n              Work Gallery\n            </button>\n            <button\n              id=\"mob_nav_link_book\"\n              onClick={() => { setSelectedTab(\"book\"); setMobileMenuOpen(false); setPassedService(\"\"); window.location.hash = \"#book\"; }}\n              className={`w-full text-left font-bold text-xs uppercase tracking-wider block py-2.5 px-3 rounded-lg ${\n                selectedTab === \"book\" ? \"bg-[#b45309] text-white\" : \"text-zinc-600 bg-zinc-50 border border-zinc-150\"\n              }`}\n            >\n              Request Spot\n            </button>\n          </div>\n        )}\n      </header>\n\n      {/* BODY FRAME VIEWS */}\n      <main className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 relative\">\n        \n        {/* TAB 1: OVERVIEW */}\n        {selectedTab === \"home\" && (\n          <div className=\"space-y-16 animate-in fade-in duration-200\">\n            \n            {/* HERO MODULE SECTION */}\n            <section className=\"flex flex-col lg:flex-row items-stretch gap-10 pt-2\">\n              <div className=\"flex-1 flex flex-col justify-center space-y-6 text-center lg:text-left\">\n                \n                {/* Visual Accent Banner */}\n                <div className=\"inline-flex self-center lg:self-start items-center gap-1.5 bg-[#faf5f0] text-amber-900 font-bold text-xs px-3 py-1.5 rounded-full border border-zinc-200\">\n                  <MapPin className=\"w-3.5 h-3.5 text-amber-800\" />\n                  Cobb County, GA \342\200\224 Arthur & Carson\'s Crew\n                </div>\n\n                <h2 className=\"text-5xl sm:text-7xl font-serif font-extrabold tracking-tight text-zinc-900 leading-tight\">\n                  There\342\200\231s nothing like <br />\n                  <span className=\"bg-gradient-to-r from-amber-700 via-amber-800 to-amber-900 bg-clip-text text-transparent italic\">\n                    a clean car.\n                  </span>\n                </h2>\n\n                <p className=\"text-zinc-600 text-sm sm:text-base max-w-xl mx-auto lg:mx-0 leading-relaxed font-semibold\">\n                  Showroom hand-detailing right in your driveway. Done on-site by our expert 2-man crew: Arthur and Carson. We use meticulous hand restoration instead of harsh automated brushes to make your vehicle sparkle.\n                </p>\n\n                {/* Direct Actions */}\n                <div className=\"flex flex-col sm:flex-row justify-center lg:justify-start gap-3 pt-2 font-sans\">\n                  <button\n                    id=\"hero_cta_book_now\"\n                    onClick={() => {\n                      const element = document.getElementById(\"booking_section_view\");\n                      if (element) {\n                        element.scrollIntoView({ behavior: \"smooth\" });\n                      } else {\n                        setSelectedTab(\"book\");\n                        window.location.hash = \"#book\";\n                      }\n                    }}\n                    className=\"px-6 py-3.5 bg-[#b45309] hover:bg-[#9a3412] text-white font-bold text-xs tracking-wider uppercase transition-all duration-200 cursor-pointer rounded-lg shadow-sm\"\n                  >\n                    Request Driveway Spot\n                  </button>\n                  <button\n                    id=\"hero_cta_see_pricing\"\n                    onClick={() => { setSelectedTab(\"services\"); window.location.hash = \"#services\"; }}\n                    className=\"px-6 py-3.5 bg-white border border-zinc-200 hover:bg-zinc-50 text-zinc-700 font-bold text-xs tracking-wider uppercase transition-all duration-200 cursor-pointer rounded-lg\"\n                  >\n                    Browse Services\n                  </button>\n                </div>\n\n                {/* Direct Pricing Indicators */}\n                <div className=\"grid grid-cols-3 gap-4 pt-6 text-center lg:text-left max-w-sm mx-auto lg:mx-0 border-t border-zinc-100 mt-8\">\n                  <div>\n                    <span className=\"text-lg font-bold text-zinc-900 block font-serif\">2 Men</span>\n                    <span className=\"text-[9px] text-zinc-500 uppercase tracking-wider font-extrabold\">on every job</span>\n                  </div>\n                  <div className=\"border-x border-zinc-100 px-2\">\n                    <span className=\"text-lg font-bold text-zinc-900 block font-serif\">1 - 3 Hrs</span>\n                    <span className=\"text-[9px] text-zinc-500 uppercase tracking-wider font-extrabold\">avg duration</span>\n                  </div>\n                  <div>\n                    <span className=\"text-lg font-bold text-[#b45309] block font-serif\">Est. $45+*</span>\n                    <span className=\"text-[9px] text-zinc-500 uppercase tracking-wider font-extrabold\">Varies by Size / Dirt</span>\n                  </div>\n                </div>\n\n              </div>\n\n              {/* HERO RIGHT COLUMN: INSTANT DIRECT BOOKING FORM */}\n              <div id=\"booking_section_view\" className=\"flex-1 flex items-center justify-center relative animate-in zoom-in-95 duration-200\">\n                <div className=\"relative w-full max-w-md bg-white border border-zinc-200 p-6 sm:p-8 shadow-sm rounded-2xl\">\n                  <div className=\"absolute -top-3 right-4 bg-amber-100 text-[#b45309] text-[9px] font-bold px-3 py-1 rounded-full border border-amber-200/50 shadow-sm uppercase tracking-wider\">\n                    Book On-Site Online\n                  </div>\n                  \n                  <div className=\"text-center mb-6\">\n                    <h3 className=\"text-base font-serif font-bold text-zinc-900 uppercase tracking-tight\">\n                      Request Detailing Session\n                    </h3>\n                    <p className=\"text-[10px] text-zinc-500 mt-1 tracking-wider font-bold\">Schedule directly with Arthur and Carson</p>\n                  </div>\n                  \n                  <BookingForm initialService={passedService} />\n                </div>\n              </div>\n            </section>\n\n            {/* ARTISAN PLEDGE & CLEAN SERVICE STANDARDS */}\n            <section className=\"bg-zinc-50 border border-zinc-200 p-6 sm:p-8 rounded-2xl flex flex-col md:flex-row gap-6 items-center\">\n              <div className=\"flex items-center gap-3.5 shrink-0\">\n                <div className=\"w-12 h-12 rounded-full bg-[#b45309] flex items-center justify-center font-bold text-sm text-white shadow-sm font-serif\">\n                  AC\n                </div>\n                <div className=\"text-left\">\n                  <h4 className=\"text-sm font-sans font-extrabold text-zinc-900 uppercase tracking-wider\">Arthur & Carson</h4>\n                  <span className=\"text-[10px] text-amber-800 font-extrabold tracking-wider block uppercase\">Driveway Mobile Specialists</span>\n                </div>\n              </div>\n              <div className=\"flex-1 text-left border-t md:border-t-0 md:border-l border-zinc-200/80 pt-4 md:pt-0 md:pl-6 leading-relaxed\">\n                <p className=\"text-xs sm:text-sm text-zinc-650 leading-relaxed font-semibold\">\n                  \"We operate North Cobb Detailing with neighborly respect. We don\'t bring heavy, roaring gas generators that disturb your peace. We connect cleanly to your outdoor spigot and electrical plug\342\200\224handling detailing entirely with hand care and reviewing the final shiny result together with you before any payment is processed.\"\n                </p>\n                \n                <div className=\"mt-4 flex flex-col sm:flex-row gap-3 text-[10px] font-extrabold text-[#b45309]\">\n                  <span className=\"flex items-center gap-1.5 bg-white border border-zinc-200 px-3 py-1.5 rounded-lg shadow-sm\">\n                    <Check className=\"w-3 h-3 text-[#b45309]\" /> Standard outdoor spigot required\n                  </span>\n                  <span className=\"flex items-center gap-1.5 bg-white border border-zinc-200 px-3 py-1.5 rounded-lg shadow-sm\">\n                    <Check className=\"w-3 h-3 text-[#b45309]\" /> Outdoor wall electrical outlet required\n                  </span>\n                </div>\n              </div>\n            </section>\n\n            {/* PREVIEW GALLERY SHOWCASE */}\n            <section className=\"py-2 space-y-6\">\n              <div className=\"text-center space-y-1\">\n                <span className=\"text-amber-800 font-bold text-xs uppercase tracking-widest\">Our Work</span>\n                <h3 className=\"text-3xl font-serif font-bold text-zinc-900\">Showroom Sneak-Peek</h3>\n                <p className=\"text-zinc-500 text-xs sm:text-sm font-semibold\">We pride ourselves on flawless hand washes, interior vacuuming, and mirror paint corrections.</p>\n              </div>\n              <WorkGallery />\n            </section>\n\n            {/* SERVICES PREVIEW INDEX */}\n            <section className=\"space-y-6\">\n              <div className=\"text-center max-w-xl mx-auto space-y-1\">\n                <span className=\"text-amber-800 font-bold text-xs tracking-wider uppercase\">Our Services</span>\n                <h3 className=\"text-3xl font-serif font-bold text-zinc-900 tracking-tight\">Our Honest Services Index</h3>\n                <p className=\"text-zinc-500 text-xs sm:text-sm font-semibold\">Select from our honest packages. Driveway estimations are straightforward and easy to fit on any calendar.</p>\n              </div>\n              <ServicesDetail onSelectService={scrollToBookingAndSelect} />\n            </section>\n\n            {/* REVIEWS SECTION */}\n            <section className=\"space-y-6 py-2\">\n              <div className=\"text-center max-w-xl mx-auto\">\n                <span className=\"text-[#b45309] font-bold text-xs tracking-wider uppercase\">Client Reviews</span>\n                <h3 className=\"text-3xl font-serif font-bold text-zinc-900 mt-1 tracking-tight\">Cobb County Driveway Reviews</h3>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n                <div className=\"bg-white border border-zinc-200 p-6 rounded-2xl space-y-4 hover:shadow-sm text-left\">\n                  <div className=\"flex gap-0.5 text-amber-600\">\n                    {[1,2,3,4,5].map((s) => <Star key={s} className=\"w-3.5 h-3.5 fill-current stroke-none\" />)}\n                  </div>\n                  <p className=\"text-zinc-600 text-xs sm:text-sm leading-relaxed font-medium\">\n                    \"Called the team for an Exterior Detail because of baking-hot tree sap on my sedan in Acworth. They arrived right on schedule and completely restored the clear coat\'s mirror look. Excellent neighborly service!\"\n                  </p>\n                  <div className=\"pt-3 border-t border-dashed border-zinc-150 flex justify-between items-center text-[10px] font-extrabold text-zinc-400\">\n                    <span>MICHAEL R.</span>\n                    <span>Acworth Resident</span>\n                  </div>\n                </div>\n\n                <div className=\"bg-white border border-zinc-200 p-6 rounded-2xl space-y-4 hover:shadow-sm text-left\">\n                  <div className=\"flex gap-0.5 text-amber-600\">\n                    {[1,2,3,4,5].map((s) => <Star key={s} className=\"w-3.5 h-3.5 fill-current stroke-none\" />)}\n                  </div>\n                  <p className=\"text-zinc-600 text-xs sm:text-sm leading-relaxed font-medium\">\n                    \"The Interior Detail is a complete life saver with toddlers. All the embedded sand and accidental spills are entirely gone. The cabin space feels so refreshed and sanitized!\"\n                  </p>\n                  <div className=\"pt-3 border-t border-dashed border-zinc-150 flex justify-between items-center text-[10px] font-extrabold text-zinc-400\">\n                    <span>JESSICA T.</span>\n                    <span>Kennesaw, GA</span>\n                  </div>\n                </div>\n\n                <div className=\"bg-white border border-zinc-200 p-6 rounded-2xl space-y-4 hover:shadow-sm text-left\">\n                  <div className=\"flex gap-0.5 text-amber-600\">\n                    {[1,2,3,4,5].map((s) => <Star key={s} className=\"w-3.5 h-3.5 fill-current stroke-none\" />)}\n                  </div>\n                  <p className=\"text-zinc-600 text-xs sm:text-sm leading-relaxed font-medium\">\n                    \"Super straightforward self-sufficient car care. The carnauba dressing leaves a beautiful glass shine and water beads right off. Best of all, I inspected my paint together with the crew before paying.\"\n                  </p>\n                  <div className=\"pt-3 border-t border-dashed border-zinc-150 flex justify-between items-center text-[10px] font-extrabold text-zinc-400\">\n                    <span>DAVID H.</span>\n                    <span>Marietta Resident</span>\n                  </div>\n                </div>\n              </div>\n            </section>\n\n          </div>\n        )}\n\n        {/* TAB 2: DETAILED SERVICES INDEX */}\n        {selectedTab === \"services\" && (\n          <div className=\"space-y-8 animate-in fade-in duration-200\">\n            <div className=\"text-center max-w-2xl mx-auto space-y-1\">\n              <span className=\"text-amber-800 font-bold text-xs tracking-wider uppercase font-sans\">Services</span>\n              <h3 className=\"text-3xl font-serif font-bold text-zinc-900 tracking-tight\">Our Honest Services Index</h3>\n              <p className=\"text-zinc-500 text-xs sm:text-sm font-semibold\">We maintain honest, transparent pricing estimates. Check what each driveway service includes, then reserve your preferred day.</p>\n            </div>\n            \n            <ServicesDetail onSelectService={scrollToBookingAndSelect} />\n\n            {/* FAQs */}\n            <div className=\"max-w-3xl mx-auto mt-12 bg-zinc-50 border border-zinc-200 p-6 sm:p-8 rounded-2xl space-y-6\">\n              <h4 className=\"text-lg font-serif font-bold text-zinc-900 text-center uppercase tracking-tight\">\n                Frequently Asked Detailing Questions\n              </h4>\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-zinc-200 text-xs sm:text-sm text-left\">\n                <div className=\"space-y-1\">\n                  <strong className=\"text-zinc-900 font-extrabold block text-sm\">Do you require water or electricity?</strong>\n                  <p className=\"text-zinc-600 leading-relaxed text-xs font-semibold\">Yes, to maintain a quiet experience we connect cleanly to one standard residential water spigot and one standard outdoor wall electrical outlet.</p>\n                </div>\n                <div className=\"space-y-1\">\n                  <strong className=\"text-zinc-900 font-extrabold block text-sm\">How long does each detailing session take?</strong>\n                  <p className=\"text-zinc-600 leading-relaxed text-xs font-semibold\">An Exterior Detail takes about 1 hour, an Interior Detail is roughly 1.5 hours, and our comprehensive Full Detail is just under 3 hours of meticulous hand-care.</p>\n                </div>\n                <div className=\"space-y-1\">\n                  <strong className=\"text-zinc-900 font-extrabold block text-sm\">How far in advance should I book?</strong>\n                  <p className=\"text-zinc-600 leading-relaxed text-xs font-semibold\">Please send your request at least 24 hours in advance to secure a listing. We will get back to you immediately to confirm.</p>\n                </div>\n                <div className=\"space-y-1\">\n                  <strong className=\"text-zinc-900 font-extrabold block text-sm\">Are your formulas children and pet safe?</strong>\n                  <p className=\"text-zinc-600 leading-relaxed text-xs font-semibold\">Absolutely. We utilize premium professional-grade, pH-balanced formulas that are harmless to children and pet paws once dry, while remaining deeply effective at lifting real Georgia grit.</p>\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* TAB 3: DEDICATED FULL SHOWROOM GALLERY PAGE */}\n        {selectedTab === \"gallery\" && (\n          <div className=\"space-y-8 animate-in fade-in duration-200\">\n            <WorkGallery />\n          </div>\n        )}\n\n        {/* TAB 4: RESERVATION BOOKINGS */}\n        {selectedTab === \"book\" && (\n          <div id=\"booking_section_view\" className=\"space-y-8 animate-in fade-in duration-200\">\n            <div className=\"text-center max-w-xl mx-auto space-y-1\">\n              <span className=\"text-amber-800 font-bold text-xs tracking-wider uppercase font-sans\">Reservations</span>\n              <h3 className=\"text-3xl font-serif font-bold text-zinc-900 tracking-tight\">Request Detailing Session</h3>\n              <p className=\"text-zinc-500 text-xs sm:text-sm font-semibold\">Submit your detailing day and package selections below. We coordinate pending Cobb County schedule slots daily and send instant confirmations.</p>\n            </div>\n\n            <div className=\"max-w-md mx-auto bg-white border border-zinc-200 p-6 sm:p-8 rounded-2xl shadow-sm\">\n              <BookingForm initialService={passedService} />\n            </div>\n          </div>\n        )}\n\n        {/* TAB 5: PRIVATE OWNER PORTAL */}\n        {selectedTab === \"owner\" && (\n          <div className=\"space-y-6 animate-in fade-in duration-200 pb-10\">\n            <div className=\"bg-zinc-50 border border-zinc-200 p-6 flex flex-col sm:flex-row items-center justify-between gap-4 rounded-2xl\">\n              <div className=\"flex items-center gap-3 text-left\">\n                <div className=\"bg-neutral-900 text-white px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase\">\n                  Admin Portal\n                </div>\n                <div>\n                  <h4 className=\"text-sm font-bold text-zinc-900\">Private Dashboard Manager</h4>\n                  <p className=\"text-xs text-zinc-500\">Safely coordinate local driveway requested slots and update scheduling states.</p>\n                </div>\n              </div>\n              <button\n                onClick={() => { setSelectedTab(\"home\"); window.location.hash = \"\"; }}\n                className=\"px-4 py-2 bg-zinc-900 hover:bg-black text-white text-xs font-semibold rounded-lg transition-colors cursor-pointer\"\n              >\n                Return to Public Site\n              </button>\n            </div>\n            <AdminPortal />\n          </div>\n        )}\n\n      </main>\n\n      {/* COMPACT FOOTER */}\n      <footer className=\"border-t border-zinc-200 bg-zinc-50 text-zinc-500 mt-20\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col md:flex-row items-center justify-between gap-6 text-xs\">\n          <div className=\"text-center md:text-left space-y-2\">\n            <p className=\"font-extrabold text-[#2e261f] tracking-wider uppercase font-sans\">\n              North Cobb Mobile Auto Detail\n            </p>\n            <p className=\"text-[10px] text-zinc-450\">\302\251 {new Date().getFullYear()} North Cobb Detailing. All Rights Reserved.</p>\n            <p className=\"text-[10px] text-zinc-450 leading-relaxed\">\n              Website created by <span className=\"text-zinc-700 font-bold\">Neil Menepdar</span> with SEO\n            </p>\n            <p className=\"text-xs max-w-sm text-zinc-550 pt-1 leading-relaxed font-medium\">\n              Top-rated parent & pet friendly local driveway detailing across Kennesaw, Acworth, Marietta, and Cobb County, Georgia.\n            </p>\n          </div>\n          \n          {/* Facebook Link & Navigation */}\n          <div className=\"flex flex-col items-center md:items-end gap-2.5 text-xs\">\n            <div className=\"flex flex-wrap justify-center gap-3.5 font-bold tracking-wider text-zinc-600 uppercase\">\n              <button onClick={() => { setSelectedTab(\"home\"); window.location.hash = \"\"; }} className=\"hover:text-amber-800 transition-colors cursor-pointer\">Overview</button>\n              <span>\342\200\242</span>\n              <button onClick={() => { setSelectedTab(\"services\"); window.location.hash = \"#services\"; }} className=\"hover:text-amber-800 transition-colors cursor-pointer\">Services</button>\n              <span>\342\200\242</span>\n              <button onClick={() => { setSelectedTab(\"gallery\"); window.location.hash = \"#gallery\"; }} className=\"hover:text-amber-800 transition-colors cursor-pointer\">Gallery</button>\n              <span>\342\200\242</span>\n              <button onClick={() => { setSelectedTab(\"book\"); window.location.hash = \"#book\"; }} className=\"hover:text-amber-800 transition-colors cursor-pointer\">Request spot</button>\n              <span>\342\200\242</span>\n              <a \n                href=\"https://www.facebook.com/people/North-Cobb-Detailing/pfbid02hkyF1tuWGoGWDAVMadwH6xTU6RRLdENWVMiLiqQqpBsDzhbiS7h363i8QmHEyd3el/\" \n                target=\"_blank\" \n                rel=\"noopener noreferrer\"\n                className=\"flex items-center gap-1 bg-white border border-zinc-200 hover:border-zinc-300 px-2.5 py-1 rounded-md text-amber-800 hover:text-amber-900 transition-all shadow-sm\"\n              >\n                <span>Facebook Page</span>\n                <span className=\"text-[9px] bg-amber-50 px-1.5 py-0.5 rounded text-amber-900 font-bold ml-1\">LIKE</span>\n              </a>\n            </div>\n            \n            <span className=\"text-[10px] text-zinc-400 block text-center md:text-right font-medium\">\n              Mobile Residential Car Detailing \342\200\242 Handwashed Trust\n            </span>\n          </div>\n        </div>\n      </footer>\n\n      {/* HIGH-CONVERSION MOBILE FLOATING STICKY ACTION BAR */}\n      {!isOwner && (\n        <div className=\"fixed bottom-0 left-0 right-0 z-40 md:hidden bg-white/95 backdrop-blur-md border-t border-zinc-200 p-3 flex gap-3 shadow-[0_-8px_24px_rgba(0,0,0,0.05)]\">\n          <a \n            href=\"tel:+12087707517\"\n            className=\"flex-1 flex items-center justify-center gap-1.5 py-3 bg-zinc-50 border border-zinc-350 text-zinc-800 font-bold text-xs uppercase tracking-wider transition-all rounded-xl\"\n          >\n            <PhoneCall className=\"w-3.5 h-3.5 text-[#b45309]\" />\n            Call / Text\n          </a>\n          <button\n            onClick={() => {\n              setSelectedTab(\"book\");\n              window.location.hash = \"#book\";\n              setTimeout(() => {\n                const el = document.getElementById(\"booking_section_view\");\n                if (el) el.scrollIntoView({ behavior: \"smooth\" });\n              }, 120);\n            }}\n            className=\"flex-1 flex items-center justify-center gap-1.5 py-3 bg-[#b45309] hover:bg-[#9a3412] text-white font-bold text-xs uppercase tracking-wider transition-all rounded-xl cursor-pointer\"\n          >\n            Request Spot\n          </button>\n        </div>\n      )}\n\n    </div>\n  );\n}\n"

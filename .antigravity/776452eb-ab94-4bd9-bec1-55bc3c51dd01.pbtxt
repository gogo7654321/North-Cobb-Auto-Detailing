  file_change {
    absolute_path_uri: "file:///src/components/BeforeAfter.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import { useState, useRef, useEffect } from \"react\";\nimport { ArrowLeftRight } from \"lucide-react\";\n\nexport default function BeforeAfter() {\n  const [sliderPosition, setSliderPosition] = useState(50);\n  const [isDragging, setIsDragging] = useState(false);\n  const [containerWidth, setContainerWidth] = useState(576);\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  const handleMove = (clientX: number) => {\n    if (!containerRef.current) return;\n    const rect = containerRef.current.getBoundingClientRect();\n    const x = clientX - rect.left;\n    const percentage = Math.max(0, Math.min(100, (x / rect.width) * 100));\n    setSliderPosition(percentage);\n  };\n\n  const handleTouchMove = (e: TouchEvent) => {\n    if (!isDragging) return;\n    handleMove(e.touches[0].clientX);\n  };\n\n  const handleMouseMove = (e: MouseEvent) => {\n    if (!isDragging) return;\n    handleMove(e.clientX);\n  };\n\n  const handleMouseUp = () => {\n    setIsDragging(false);\n  };\n\n  useEffect(() => {\n    if (containerRef.current) {\n      setContainerWidth(containerRef.current.getBoundingClientRect().width);\n    }\n    const handleResize = () => {\n      if (containerRef.current) {\n        setContainerWidth(containerRef.current.getBoundingClientRect().width);\n      }\n    };\n    window.addEventListener(\"resize\", handleResize);\n    return () => window.removeEventListener(\"resize\", handleResize);\n  }, []);\n\n  useEffect(() => {\n    if (isDragging) {\n      window.addEventListener(\"mousemove\", handleMouseMove);\n      window.addEventListener(\"mouseup\", handleMouseUp);\n      window.addEventListener(\"touchmove\", handleTouchMove);\n      window.addEventListener(\"touchend\", handleMouseUp);\n    }\n    return () => {\n      window.removeEventListener(\"mousemove\", handleMouseMove);\n      window.removeEventListener(\"mouseup\", handleMouseUp);\n      window.removeEventListener(\"touchmove\", handleTouchMove);\n      window.removeEventListener(\"touchend\", handleMouseUp);\n    };\n  }, [isDragging]);\n\n  return (\n    <div className=\"flex flex-col items-center select-none font-sans\">\n      <div className=\"text-center mb-6 max-w-lg\">\n        <h3 className=\"text-2xl font-serif font-black text-[#2e261f]\">\n          Driveway Transformation\n        </h3>\n        <p className=\"text-[#5c544a] text-xs sm:text-sm mt-1.5 leading-relaxed font-semibold\">\n          Slide the bar to inspect physical hand restoration\342\200\224from backed-on road grime to a hand-glazed showroom finish.\n        </p>\n      </div>\n\n      {/* Slider Area */}\n      <div\n        id=\"before_after_slider_container\"\n        ref={containerRef}\n        onMouseDown={() => setIsDragging(true)}\n        onTouchStart={() => setIsDragging(true)}\n        className=\"relative w-full max-w-xl aspect-[16/10] overflow-hidden cursor-ew-resize border-2 border-[#e6dccf] bg-[#faf8f5]\"\n        style={{ borderRadius: \"24px 4px 24px 4px\" }}\n      >\n        {/* RIGHT IMAGE: After (Beautifully detailed, high-contrast, premium text) */}\n        <div className=\"absolute inset-0 bg-[#fffdfa] flex flex-col justify-center items-center p-8 text-center\">\n          <div className=\"absolute inset-0 bg-gradient-to-tr from-amber-500/5 to-transparent\" />\n          {/* Detailed car silhouette vector */}\n          <svg className=\"w-48 h-48 text-[#b45309]/10 mb-2 relative z-10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.2\">\n            <path d=\"M4 10h16M4 14h16M3 7h18c.5 0 1 .5 1 1v8c0 .5-.5 1-1 1H3c-.5 0-1-.5-1-1v-8c0-.5.5-1 1-1z\" strokeLinecap=\"round\"/>\n            <circle cx=\"6\" cy=\"12\" r=\"2\" fill=\"currentColor\"/>\n            <circle cx=\"18\" cy=\"12\" r=\"2\" fill=\"currentColor\"/>\n          </svg>\n          <div className=\"relative z-10 space-y-2\">\n            <span className=\"bg-[#fff9e6] text-amber-900 font-bold text-[10px] sm:text-xs px-4 py-1 border border-amber-300/60 uppercase tracking-widest rounded\">\n              After Hand Restoration\n            </span>\n            <p className=\"text-[#2e261f] font-serif font-black text-lg sm:text-xl mt-3\">Mirror Paint Gloss & Deep Clean Cabin</p>\n            <p className=\"text-xs text-[#5c544a] max-w-xs mx-auto\">Swirls smoothed, carpet stains extracted, upholstery conditioned, glass streak-free.</p>\n          </div>\n          \n          <div className=\"absolute top-[25%] left-[25%] w-2 h-2 bg-amber-400 rounded-full opacity-60\" />\n          <div className=\"absolute bottom-[30%] right-[25%] w-2.5 h-2.5 bg-amber-300 rounded-full opacity-30\" />\n        </div>\n\n        {/* LEFT IMAGE: Before (Grimy road buildup, dull textures) */}\n        <div \n          className=\"absolute inset-y-0 left-0 overflow-hidden bg-[#faf6f0]\"\n          style={{ width: `${sliderPosition}%` }}\n        >\n          {/* Fixed width matching parent scale to prevent squash when slide croppings change */}\n          <div \n            className=\"absolute inset-y-0 left-0 bg-[#f5efeb] flex flex-col justify-center items-center p-8 text-center\"\n            style={{ width: `${containerWidth}px` }}\n          >\n            {/* Dirty silhouette mockup */}\n            <svg className=\"w-48 h-48 text-[#cbd5e1] mb-2\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.2\">\n              <path d=\"M4 10h16M4 14h16M3 7h18c.5 0 1 .5 1 1v8c0 .5-.5 1-1 1H3c-.5 0-1-.5-1-1v-8c0-.5.5-1 1-1z\" strokeLinecap=\"round\"/>\n              <path d=\"M2.5 18s1.5-1 3.5-1 4 2 6 0\" stroke=\"currentColor\" strokeWidth=\"1.2\" strokeLinecap=\"round\"/>\n            </svg>\n            <div className=\"space-y-4\">\n              <span className=\"bg-zinc-200 text-zinc-650 font-bold text-[10px] sm:text-xs px-4 py-1 uppercase tracking-widest rounded\">\n                Before Service Detail\n              </span>\n              <p className=\"text-zinc-700 font-serif font-black text-lg sm:text-xl mt-3\">Oxidation, Dirt & Clay Grime</p>\n              <p className=\"text-xs text-[#6e6357] max-w-xs mx-auto\">Georgia red clay mud, baked-on tree sap, yellow pollen crust, and passenger snack spills.</p>\n            </div>\n            \n            <div className=\"absolute top-[20%] right-[30%] w-4 h-3 bg-amber-900/10 rounded-full filter blur-[1px]\" />\n            <div className=\"absolute bottom-[25%] left-[20%] w-6 h-4 bg-amber-950/15 rounded-full filter blur-[3px]\" />\n          </div>\n        </div>\n\n        {/* Tactile Retro dividing bar */}\n        <div \n          className=\"absolute inset-y-0 w-0.5 bg-[#b45309] cursor-ew-resize shadow-md\"\n          style={{ left: `${sliderPosition}%` }}\n        >\n          {/* Physical handcraft feel drag thumb */}\n          <div className=\"absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-9 h-9 bg-white rounded-full border-2 border-[#b45309] flex items-center justify-center text-[#b45309] hover:scale-110 active:scale-95 transition-all duration-200 shadow shadow-[#b45309]/20\"\n            style={{ borderRadius: \"50%\" }}\n          >\n            <ArrowLeftRight className=\"w-4 h-4 stroke-[2.5]\" />\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}"
      replacement_content: "import { useState, useRef, useEffect } from \"react\";\nimport { ArrowLeftRight, Check, Sparkles, Flame, Scissors, Eye, Trash, RefreshCw } from \"lucide-react\";\n\ninterface BeforeAfterProject {\n  id: string;\n  title: string;\n  category: string;\n  beforeSrc: string;\n  afterSrc: string;\n  description: string;\n  details: string;\n  highlights: string[];\n}\n\nconst PROJECTS: BeforeAfterProject[] = [\n  {\n    id: \"dashboard_console\",\n    title: \"Dashboard & Console Reset\",\n    category: \"Interior Detailing\",\n    beforeSrc: \"/IMG_7825.jpeg\",\n    afterSrc: \"/IMG_7826.jpeg\",\n    description: \"Deep console wiping, cup holder steam extraction, and high-touch grease removal.\",\n    details: \"Severe sticky soda residue, embedded dust in climate control gaps, and finger oil smudges on piano black trims fully purged for a satin-matte factory appearance.\",\n    highlights: [\"pH-balanced deep scrubbing\", \"Streak-free tactile finish\", \"Anti-static gloss glaze\"]\n  },\n  {\n    id: \"floor_carpet\",\n    title: \"Footwell Carpet Soil Extraction\",\n    category: \"Interior Detailing\",\n    beforeSrc: \"/IMG_7827.jpeg\",\n    afterSrc: \"/IMG_7828.jpeg\",\n    description: \"Deep fiber agitation & complete vacuum flush of embedded Georgia red clay mud.\",\n    details: \"Years of salt spots, dried mud, and passenger food crumbs dissolved and cleanly extracted from heavy dense footwell pile, leaving refreshed, plush black carpets.\",\n    highlights: [\"Enzyme dirt dissolve sweep\", \"Rotary fiber decontamination\", \"Full chemical fiber dry extraction\"]\n  },\n  {\n    id: \"cargo_pethair\",\n    title: \"Cargo Area Pet Hair Removal\",\n    category: \"Full Detailing\",\n    beforeSrc: \"/IMG_7829.jpeg\",\n    afterSrc: \"/IMG_7830.jpeg\",\n    description: \"Thorough electrostatic sweeps listing stubborn pet fur woven into luggage mats.\",\n    details: \"Densely woven animal fur and organic dander clinging to interior velour materials removed without fraying the original manufacturer carpet weaves.\",\n    highlights: [\"Electrostatic rubber brushing\", \"Double-stage vacuum purge\", \"Upholstery refreshing deodorizer\"]\n  },\n  {\n    id: \"door_jambs\",\n    title: \"Door Hamb Paint Scrub\",\n    category: \"Exterior Prep\",\n    beforeSrc: \"/IMG_7837.jpeg\",\n    afterSrc: \"/IMG_7838.jpeg\",\n    description: \"Stripping off baked-on pollen, road spray mud, and greasy hinge blowout contaminants.\",\n    details: \"Hidden panels and drain channels deep-cleaned with detailing brushes, washed clean, and sealed with paint protector for a high-gloss water beading edge.\",\n    highlights: [\"Hinge grease sweep\", \"High-frequency detailing brushing\", \"Precision synthetic paint sealant\"]\n  },\n  {\n    id: \"alloy_wheels\",\n    title: \"Alloy Wheel Dust Flush\",\n    category: \"Exterior Detailing\",\n    beforeSrc: \"/IMG_7812.jpeg\",\n    afterSrc: \"/IMG_7813.jpeg\",\n    description: \"Cleansing highly caustic dark brake soot and restoring original rubber sidewalls.\",\n    details: \"Inner wheel barrels and face spokes cleansed with non-acid color-changing wheel wash, followed by premium deep-black tire dress protectant.\",\n    highlights: [\"Active iron break-down wash\", \"Inner barrel scrubber tool\", \"Satin UV tire protection finish\"]\n  }\n];\n\nexport default function BeforeAfter() {\n  const [activeProjIdx, setActiveProjIdx] = useState(0);\n  const [sliderPosition, setSliderPosition] = useState(50);\n  const [isDragging, setIsDragging] = useState(false);\n  const [containerWidth, setContainerWidth] = useState(576);\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  const activeProject = PROJECTS[activeProjIdx];\n\n  const handleMove = (clientX: number) => {\n    if (!containerRef.current) return;\n    const rect = containerRef.current.getBoundingClientRect();\n    const x = clientX - rect.left;\n    const percentage = Math.max(0, Math.min(100, (x / rect.width) * 100));\n    setSliderPosition(percentage);\n  };\n\n  const handleTouchMove = (e: TouchEvent) => {\n    if (!isDragging) return;\n    handleMove(e.touches[0].clientX);\n  };\n\n  const handleMouseMove = (e: MouseEvent) => {\n    if (!isDragging) return;\n    handleMove(e.clientX);\n  };\n\n  const handleMouseUp = () => {\n    setIsDragging(false);\n  };\n\n  useEffect(() => {\n    if (containerRef.current) {\n      setContainerWidth(containerRef.current.getBoundingClientRect().width);\n    }\n    const handleResize = () => {\n      if (containerRef.current) {\n        setContainerWidth(containerRef.current.getBoundingClientRect().width);\n      }\n    };\n    window.addEventListener(\"resize\", handleResize);\n    return () => window.removeEventListener(\"resize\", handleResize);\n  }, [activeProjIdx]); // recalculate whenever we switch panels as layout updates\n\n  useEffect(() => {\n    if (isDragging) {\n      window.addEventListener(\"mousemove\", handleMouseMove);\n      window.addEventListener(\"mouseup\", handleMouseUp);\n      window.addEventListener(\"touchmove\", handleTouchMove);\n      window.addEventListener(\"touchend\", handleMouseUp);\n    }\n    return () => {\n      window.removeEventListener(\"mousemove\", handleMouseMove);\n      window.removeEventListener(\"mouseup\", handleMouseUp);\n      window.removeEventListener(\"touchmove\", handleTouchMove);\n      window.removeEventListener(\"touchend\", handleMouseUp);\n    };\n  }, [isDragging]);\n\n  // Reset slider position on project switch to trigger satisfying feel\n  const handleProjectChange = (idx: number) => {\n    setActiveProjIdx(idx);\n    setSliderPosition(50);\n  };\n\n  return (\n    <div className=\"flex flex-col items-center select-none font-sans max-w-5xl mx-auto w-full\">\n      <div className=\"text-center mb-8 max-w-lg mx-auto\">\n        <span className=\"text-amber-850 font-bold font-mono text-xs tracking-widest uppercase block mb-1\">\n          [ INTERACTIVE INSPECTOR ]\n        </span>\n        <h3 className=\"text-3xl font-serif font-black text-[#2e261f]\">\n          Real Detailing Proof\n        </h3>\n        <p className=\"text-[#5c544a] text-xs sm:text-sm mt-1.5 leading-relaxed font-semibold\">\n          Slide the center handle to see before and after handcraft restoration done right here in Cobb County.\n        </p>\n      </div>\n\n      {/* Project Switch Buttons Grid */}\n      <div className=\"flex flex-wrap items-center justify-center gap-2 mb-8 bg-[#f5efe6] p-2 border-2 border-[#e6dccf] w-full max-w-3xl rounded-2xl\">\n        {PROJECTS.map((project, idx) => (\n          <button\n            key={project.id}\n            onClick={() => handleProjectChange(idx)}\n            className={`px-3 py-2 text-[10px] sm:text-xs font-black uppercase tracking-wider transition-all duration-150 cursor-pointer rounded-lg ${\n              activeProjIdx === idx\n                ? \"bg-[#b45309] text-white shadow-sm font-black\"\n                : \"text-[#5c544a] hover:bg-[#e6dccf]/50 hover:text-zinc-900\"\n            }`}\n            style={{ borderRadius: \"10px 2.5px 10px 2.5px\" }}\n          >\n            {project.title.split(\" \")[0]} Area\n          </button>\n        ))}\n      </div>\n\n      {/* Slider & Info Side by Side Layout */}\n      <div className=\"grid grid-cols-1 md:grid-cols-12 gap-8 items-stretch w-full\">\n        \n        {/* Slider Frame */}\n        <div className=\"md:col-span-7 flex flex-col justify-center\">\n          <div\n            id=\"before_after_slider_container\"\n            ref={containerRef}\n            onMouseDown={() => setIsDragging(true)}\n            onTouchStart={() => setIsDragging(true)}\n            className=\"relative w-full aspect-[16/10] overflow-hidden cursor-ew-resize border-4 border-[#2e261f] shadow-2xl bg-[#faf8f5]\"\n            style={{ borderRadius: \"24px 4px 24px 4px\" }}\n          >\n            {/* RIGHT IMAGE: After */}\n            <div className=\"absolute inset-0 bg-[#fffdfa] w-full h-full\">\n              <img\n                src={activeProject.afterSrc}\n                alt={`${activeProject.title} After`}\n                className=\"w-full h-full object-cover pointer-events-none select-none\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <div className=\"absolute bottom-4 right-4 bg-[#fff9e6] border border-amber-400 text-amber-950 font-bold text-[8px] sm:text-[10px] px-3 py-1 cursor-default tracking-widest uppercase\"\n                style={{ borderRadius: \"4px 1px 4px 1px\" }}\n              >\n                Sparkling After Detail\n              </div>\n            </div>\n\n            {/* LEFT IMAGE: Before */}\n            <div \n              className=\"absolute inset-y-0 left-0 overflow-hidden\"\n              style={{ width: `${sliderPosition}%` }}\n            >\n              {/* Force image to remain at full container size to align perfectly underneath */}\n              <div \n                className=\"absolute inset-y-0 left-0 bg-[#e5e7eb]\"\n                style={{ width: `${containerWidth}px` }}\n              >\n                <img\n                  src={activeProject.beforeSrc}\n                  alt={`${activeProject.title} Before`}\n                  className=\"w-full h-full object-cover pointer-events-none select-none\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                <div className=\"absolute bottom-4 left-4 bg-zinc-900/90 border border-zinc-700 text-zinc-300 font-bold text-[8px] sm:text-[10px] px-3 py-1 cursor-default tracking-widest uppercase\"\n                  style={{ borderRadius: \"4px 1px 4px 1px\" }}\n                >\n                  Oxidized Before Grime\n                </div>\n              </div>\n            </div>\n\n            {/* Tactile dividing handlebar */}\n            <div \n              className=\"absolute inset-y-0 w-1 bg-[#b45309] cursor-ew-resize shadow-lg flex items-center justify-center\"\n              style={{ left: `${sliderPosition}%` }}\n            >\n              {/* Tactile drag button thumb */}\n              <div className=\"absolute w-10 h-10 bg-white rounded-full border-4 border-[#2e261f] flex items-center justify-center text-[#b45309] hover:scale-110 active:scale-95 transition-all duration-150 shadow-md shadow-black/20 cursor-ew-resize\"\n                style={{ borderRadius: \"50%\" }}\n              >\n                <ArrowLeftRight className=\"w-4 h-4 stroke-[3]\" />\n              </div>\n            </div>\n          </div>\n          \n          <div className=\"flex justify-between items-center px-2 mt-3 text-[10px] font-mono tracking-wider font-extrabold text-[#5c544a]\">\n            <span>\342\206\220 SLIDE BEFORE</span>\n            <span>SLIDE AFTER \342\206\222</span>\n          </div>\n        </div>\n\n        {/* Technical Fact Sheet Panel */}\n        <div className=\"md:col-span-5 bg-white border-2 border-[#e6dccf] p-6 text-left flex flex-col justify-between space-y-6\"\n          style={{ borderRadius: \"24px 4px 24px 4px\" }}\n        >\n          <div className=\"space-y-4\">\n            <div className=\"space-y-1.5\">\n              <span className=\"bg-amber-100 text-[#b45309] font-mono font-bold text-[9px] sm:text-[10px] px-2.5 py-0.5 border border-amber-300 uppercase tracking-widest rounded\">\n                Category: {activeProject.category}\n              </span>\n              <h4 className=\"text-xl sm:text-2xl font-serif font-black text-[#2e261f] leading-tight mt-2\">\n                {activeProject.title}\n              </h4>\n              <p className=\"text-[#5c544a] text-xs sm:text-sm font-serif italic mt-1 font-semibold\">\n                \"{activeProject.description}\"\n              </p>\n            </div>\n\n            {/* Micro divider */}\n            <div className=\"h-[2px] bg-gradient-to-r from-amber-600/30 via-amber-650/10 to-transparent\" />\n\n            <div className=\"space-y-1.5\">\n              <span className=\"text-[10px] font-mono font-extrabold uppercase tracking-widest text-zinc-500 block\">\n                Technical Analysis Detail\n              </span>\n              <p className=\"text-xs text-zinc-750 font-medium leading-relaxed\">\n                {activeProject.details}\n              </p>\n            </div>\n\n            <div className=\"space-y-2 mt-1\">\n              <span className=\"text-[10px] font-mono font-extrabold uppercase tracking-widest text-[#b45309] block\">\n                Completed Checkpoints\n              </span>\n              <ul className=\"space-y-1.5\">\n                {activeProject.highlights.map((highlight, idx) => (\n                  <li key={idx} className=\"flex items-start gap-2 text-xs text-[#2e261f] font-semibold\">\n                    <Check className=\"w-3.5 h-3.5 text-amber-700 shrink-0 mt-0.5\" />\n                    <span>{highlight}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          </div>\n\n          <div className=\"pt-4 border-t border-dashed border-[#e6dccf] flex items-center justify-between text-[11px] font-mono font-bold text-zinc-500 bg-neutral-50 px-3 py-2.5 rounded-lg border\">\n            <span className=\"flex items-center gap-1.5\">\n              <Sparkles className=\"w-3.5 h-3.5 text-amber-500\" />\n              Driveway Handcraft\n            </span>\n            <span className=\"text-amber-850\">Arthur & Carson</span>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n}"
    }

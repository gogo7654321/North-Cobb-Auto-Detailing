    replacement_infos {
      original_chunk {
        target_content: "  const galleryItems: GalleryItem[] = [\n    {\n      id: \"exterior_edge\",\n      src: \"/IMG_0648.jpeg\",\n      title: \"Showroom Mirror Finish & Prep\",\n      category: \"Exterior\",\n      vehicle: \"Ford Edge (Magnetic Metallic)\",\n      description: \"A showcase of our multi-stage exterior hand cleanse, paint decontamination, and high-performance sealant coating in a local driveway. Notice the deep, glass-like cloud reflection on the hood.\",\n      highlights: [\n        \"Premium dual-bucket hand wash & paint surface decontamination\",\n        \"Deep water spot and baked-on tree sap extraction\",\n        \"Wheel well sanitation and brilliant clean silver alloy wheels\",\n        \"Finished with rich, high-UV resistant paint sealant protection\"\n      ],\n      specs: [\n        { label: \"Water Setup\", value: \"Standard garden spigot link\" },\n        { label: \"Power Setup\", value: \"110V Outdoor outline connection\" },\n        { label: \"Service Time\", value: \"Approx. 1 Hour\" }\n      ]\n    },\n    {\n      id: \"interior_fusion\",\n      src: \"/IMG_0659.jpeg\",\n      title: \"Piano-Black & Console Restoration\",\n      category: \"Interior\",\n      vehicle: \"Ford Fusion (Charcoal Black)\",\n      description: \"A deep interior detailing focusing on high-touch surfaces. High-gloss piano-black plastics and vinyl trims are fully restored to a lint-free, streak-free factory state with zero sticky residues.\",\n      highlights: [\n        \"Streak-free cleaning of piano-black trim surfaces\",\n        \"Anti-static cabin dusting & micro-crevice extraction\",\n        \"Sticky coffee spills and crumb removal from cup holders\",\n        \"Satin-matte, non-greasy vinyl and leather conditioning\"\n      ],\n      specs: [\n        { label: \"Surface Type\", value: \"Textured cloth & satin leather\" },\n        { label: \"Products Used\", value: \"pH-balanced enzyme cleansers\" },\n        { label: \"Service Time\", value: \"Approx. 1.5 Hours\" }\n      ]\n    },\n    {\n      id: \"interior_edge_floor\",\n      src: \"/IMG_0663.jpeg\",\n      title: \"Deep Carpet & Sill Guard Cleansing\",\n      category: \"Interior\",\n      vehicle: \"Ford Edge (Charcoal Grey Carpet)\",\n      description: \"A demonstration of meticulous footwell scrubbing, deep salt and soil vacuum extraction, and door sill guard enhancement. Even hidden bracket screws are fully cleansed.\",\n      highlights: [\n        \"Deep fiber rotary agitation & vacuum carpet extraction\",\n        \"Restoration of grey/black carpet pile to like-new feel\",\n        \"Debossing dirt and mud removal from the embossed \'EDGE\' sill plates\",\n        \"Full conditioning of door jamb plastics and rubber gaskets\"\n      ],\n      specs: [\n        { label: \"Technique\", value: \"Dual-enzyme carpet extraction\" },\n        { label: \"Attention Level\", value: \"Brackets, slide tracks & tight vents\" },\n        { label: \"Service Time\", value: \"Approx. 1.5 Hours\" }\n      ]\n    }\n  ];"
        replacement_content: "  const galleryItems: GalleryItem[] = [\n    {\n      id: \"exterior_edge\",\n      src: \"/IMG_0648.jpeg\",\n      title: \"Showroom Mirror Finish & Prep\",\n      category: \"Exterior\",\n      vehicle: \"Ford Edge (Magnetic Metallic)\",\n      description: \"A showcase of our multi-stage exterior hand cleanse, paint decontamination, and high-performance sealant coating in a local driveway. Notice the deep, glass-like cloud reflection on the hood.\",\n      highlights: [\n        \"Premium dual-bucket hand wash & paint surface decontamination\",\n        \"Deep water spot and baked-on tree sap extraction\",\n        \"Wheel well sanitation and brilliant clean silver alloy wheels\",\n        \"Finished with rich, high-UV resistant paint sealant protection\"\n      ],\n      specs: [\n        { label: \"Water Setup\", value: \"Standard garden spigot link\" },\n        { label: \"Power Setup\", value: \"110V Outdoor outline connection\" },\n        { label: \"Service Time\", value: \"Approx. 1 Hour\" }\n      ]\n    },\n    {\n      id: \"interior_fusion\",\n      src: \"/IMG_0659.jpeg\",\n      title: \"Piano-Black & Console Restoration\",\n      category: \"Interior\",\n      vehicle: \"Ford Fusion (Charcoal Black)\",\n      description: \"A deep interior detailing focusing on high-touch surfaces. High-gloss piano-black plastics and vinyl trims are fully restored to a lint-free, streak-free factory state with zero sticky residues.\",\n      highlights: [\n        \"Streak-free cleaning of piano-black trim surfaces\",\n        \"Anti-static cabin dusting & micro-crevice extraction\",\n        \"Sticky coffee spills and crumb removal from cup holders\",\n        \"Satin-matte, non-greasy vinyl and leather conditioning\"\n      ],\n      specs: [\n        { label: \"Surface Type\", value: \"Textured cloth & satin leather\" },\n        { label: \"Products Used\", value: \"pH-balanced enzyme cleansers\" },\n        { label: \"Service Time\", value: \"Approx. 1.5 Hours\" }\n      ]\n    },\n    {\n      id: \"interior_edge_floor\",\n      src: \"/IMG_0663.jpeg\",\n      title: \"Deep Carpet & Sill Guard Cleansing\",\n      category: \"Interior\",\n      vehicle: \"Ford Edge (Charcoal Grey Carpet)\",\n      description: \"A demonstration of meticulous footwell scrubbing, deep salt and soil vacuum extraction, and door sill guard enhancement. Even hidden bracket screws are fully cleansed.\",\n      highlights: [\n        \"Deep fiber rotary agitation & vacuum carpet extraction\",\n        \"Restoration of grey/black carpet pile to like-new feel\",\n        \"Debossing dirt and mud removal from the embossed \'EDGE\' sill plates\",\n        \"Full conditioning of door jamb plastics and rubber gaskets\"\n      ],\n      specs: [\n        { label: \"Technique\", value: \"Dual-enzyme carpet extraction\" },\n        { label: \"Attention Level\", value: \"Brackets, slide tracks & tight vents\" },\n        { label: \"Service Time\", value: \"Approx. 1.5 Hours\" }\n      ]\n    },\n    {\n      id: \"yukon_floor_restore\",\n      src: \"/IMG_7828.jpeg\",\n      title: \"Yukon Denali Footwell Extraction\",\n      category: \"Interior\",\n      vehicle: \"GMC Yukon Denali XL (Jet Black)\",\n      description: \"A pristine restoration of large driver-side footwells. Dissolved layers of petrified road salt, ground-in mud, and fast-food grease from thick synthetic fibers.\",\n      highlights: [\n        \"Multiple wash-rinse extraction cycles on deep-layer pile\",\n        \"Sill plastics and metal track rail detailing\",\n        \"Complete deep-vacuum extraction with commercial wet vacuums\",\n        \"Cabin ozone freshness treatment and quick-dry ventilation\"\n      ],\n      specs: [\n        { label: \"Soil Intensity\", value: \"Heavy - Red Clay & Salt\" },\n        { label: \"Detergents\", value: \"Enzymatic soil liquefier\" },\n        { label: \"Service Time\", value: \"Approx. 1.5 Hours\" }\n      ]\n    },\n    {\n      id: \"forester_hair_eradication\",\n      src: \"/IMG_7830.jpeg\",\n      title: \"Forester Cargo Area De-Furring\",\n      category: \"Full Detailing\",\n      vehicle: \"Subaru Forester (Satin Silver)\",\n      description: \"Stunning eradication of deeply interwoven golden retriever fur from tight rear cargo compartments.\",\n      highlights: [\n        \"Electrostatic rubber squeegee lifts on vertical side velours\",\n        \"Multiple high-suction lint-lifting passes\",\n        \"Sanitization of structural tie-down hooks and spare tire wells\",\n        \"Fabric protector treatment to prevent future hair weaving\"\n      ],\n      specs: [\n        { label: \"Hair Type\", value: \"Heavy Golden Retriever\" },\n        { label: \"Instruments\", value: \"Fur-rake & high-flow nozzles\" },\n        { label: \"Attention Level\", value: \"Full border seams & underlayments\" }\n      ]\n    },\n    {\n      id: \"charger_paint_jambs\",\n      src: \"/IMG_7838.jpeg\",\n      title: \"High-Gloss Door Jamb Restoration\",\n      category: \"Exterior\",\n      vehicle: \"Dodge Charger (TorRed Clearcoat)\",\n      description: \"Eliminating corrosive oily grease deposits, tree sap residues, and lime hardwater deposits from heavy metal door hinges and sill areas.\",\n      highlights: [\n        \"Hinge grease solvent wash & brush agitation\",\n        \"Double-stage pressure wash and non-conductive detail wiping\",\n        \"Finished with hand-applied synthetic glossy paint sealant\",\n        \"Door rubber trim feeding and protective UV coating\"\n      ],\n      specs: [\n        { label: \"Finish Style\", value: \"Reflective TorRed Gloss\" },\n        { label: \"Protectant\", value: \"Premium Synthetic Sealant\" },\n        { label: \"Service Time\", value: \"Approx. 45 Mins\" }\n      ]\n    }\n  ];"

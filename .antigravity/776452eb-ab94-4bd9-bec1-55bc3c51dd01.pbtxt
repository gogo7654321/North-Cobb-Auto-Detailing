        }
        lines {
          text: "  const handleNext = () => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    setActiveIdx((prev) => (prev + 1) % SHOWCASE_PHOTOS.length);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const handlePrev = () => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    setActiveIdx((prev) => (prev - 1 + SHOWCASE_PHOTOS.length) % SHOWCASE_PHOTOS.length);"

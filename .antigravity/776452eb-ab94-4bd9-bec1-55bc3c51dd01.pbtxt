        lines {
          text: "    setActiveZoneIdx(idx);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    setSelectedAngle(\"A\"); // Default to Angle A on switch"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "  const [activeIdx, setActiveIdx] = useState(0);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {

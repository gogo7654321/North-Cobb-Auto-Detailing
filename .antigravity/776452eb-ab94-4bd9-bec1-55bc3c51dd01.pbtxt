    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState } from \"react\";\nimport { Check, Sparkles, AlertCircle, ChevronLeft, ChevronRight, HelpCircle } from \"lucide-react\";\n\ninterface ShowcasePhoto {\n  id: string;\n  src: string;\n  vehicle: string;\n  category: \"Exterior\" | \"Interior\" | \"Full Detailing\";\n  title: string;\n  description: string;\n  completedPoints: string[];\n}\n\nconst SHOWCASE_PHOTOS: ShowcasePhoto[] = [\n  {\n    id: \"impala_dash_close\",\n    src: \"/IMG_7825.jpeg\",\n    category: \"Interior\",\n    vehicle: \"Chevrolet Impala (Sterling Silver)\",\n    title: \"Center Console & Trim Panel Wipe Down\",\n    description: \"Detailed manual hand-wiping of the center console surfaces, gear shifter bezel, and cup holder crevices using premium soft microfiber clothes.\",\n    completedPoints: [\n      \"Wiped down center vinyl console, gear selection lever, and trim covers by hand\",\n      \"Cleared out accumulated dust, crumbs, and sticky residues from cup compartments\",\n      \"Finished with a premium, non-greasy satin-matte protective trim dressing\"\n    ]\n  },\n  {\n    id: \"impala_dash_overall\",\n    src: \"/IMG_7826.jpeg\",\n    category: \"Interior\",\n    vehicle: \"Chevrolet Impala (Sterling Silver)\",\n    title: \"Dashboard & Steering Column Cleanse\",\n    description: \"Thorough anti-static dusting of the dashboard panels, instrument cluster shield, steering column plastics, and climate control vents.\",\n    completedPoints: [\n      \"Hand-detailed the instrument dials, buttons, and control screens\",\n      \"Lifted built-up dust from hard-to-reach climate control grill slats\",\n      \"Cleaned surrounding panels with soft non-scratching microfibers\"\n    ]\n  },\n  {\n    id: \"impala_carpet_rear\",\n    src: \"/IMG_7827.jpeg\",\n    category: \"Interior\",\n    vehicle: \"Chevrolet Impala (Sterling Silver)\",\n    title: \"Rear Cabin Footwell Vacuum\",\n    description: \"Thorough deep vacuuming of the rear footwell carpets, seat seams, and upholstery margins to extract loose dirt.\",\n    completedPoints: [\n      \"Vacuumed rear footwells, underneath the sliding front rail tracks, and mats\",\n      \"Extracted embedded dirt, small gravel bits, and loose fibers from the weave by hand\",\n      \"Inspected door sill thresholds and carpet borders for uniform cleanliness\"\n    ]\n  },\n  {\n    id: \"impala_carpet_front\",\n    src: \"/IMG_7828.jpeg\",\n    category: \"Interior\",\n    vehicle: \"Chevrolet Impala (Sterling Silver)\",\n    title: \"Driver Footwell Carpet Vacuuming\",\n    description: \"Heavy-duty driveway vacuuming around the driver-side gas/brake pedals, footrest, and seat tracks.\",\n    completedPoints: [\n      \"Vacuumed heavy soil deposits, tracked mud, and debris near driver pedals\",\n      \"Scratch-free brushing of plastic footrest panels and threshold sills\",\n      \"Micro-nozzle suction around foot pedal brackets and seat tracks\"\n    ]\n  },\n  {\n    id: \"impala_trunk_close\",\n    src: \"/IMG_7829.jpeg\",\n    category: \"Interior\",\n    vehicle: \"Chevrolet Impala (Sterling Silver)\",\n    title: \"Trunk Cargo Liner Vacuum\",\n    description: \"Deep vacuuming of the trunk load floor and surrounding carpet lining.\",\n    completedPoints: [\n      \"Extracted loose travel debris, sand, and organic particles from cargo weaves\",\n      \"Vacuumed surrounding rubber trunk seal gutters and spare tire storage lid\",\n      \"Left cargo pile groom-lined and refreshing for clean storage use\"\n    ]\n  },\n  {\n    id: \"impala_trunk_overall\",\n    src: \"/IMG_7830.jpeg\",\n    category: \"Interior\",\n    vehicle: \"Chevrolet Impala (Sterling Silver)\",\n    title: \"Luggage Area Carpet Seams\",\n    description: \"Thorough clean of the trunk loading sill and side-panel utility welds.\",\n    completedPoints: [\n      \"Suctioned fine dust and gravel out of seam-line carpet folds\",\n      \"Wiped down surrounding paint edges and steel trunk hinge bases\",\n      \"Cleaned cargo tie-down hook brackets and cargo latch casings\"\n    ]\n  },\n  {\n    id: \"impala_door_jamb_A\",\n    src: \"/IMG_7837.jpeg\",\n    category: \"Exterior\",\n    vehicle: \"Chevrolet Impala (Sterling Silver)\",\n    title: \"Door Jamb Painted Borders & Gaskets\",\n    description: \"Hand contact wipe-down of painted door jamb borders and rubber weatherstrip seals.\",\n    completedPoints: [\n      \"Wiped clean baked-on grease residues, old water spots, and pollen crust\",\n      \"Detailed painted entryway pillars and hinge hinge surfaces by hand\",\n      \"Wiped door jamb weather gaskets to prevent any future muddy contact transfers\"\n    ]\n  },\n  {\n    id: \"impala_door_jamb_B\",\n    src: \"/IMG_7838.jpeg\",\n    category: \"Exterior\",\n    vehicle: \"Chevrolet Impala (Sterling Silver)\",\n    title: \"Door Threshold Paint Edge Polish\",\n    description: \"Hand wiping painted door frame edges and cleaning scuff-prone doors threshold plastics.\",\n    completedPoints: [\n      \"Wiped down plastic door sill step plates and scuff guards\",\n      \"Cleaned away shoe marks and dirt splatters from bottom paint trim\",\n      \"Hand-polished painted jamb borders to restore high-gloss water-beading sheen\"\n    ]\n  },\n  {\n    id: \"impala_rim_detail\",\n    src: \"/IMG_7812.jpeg\",\n    category: \"Exterior\",\n    vehicle: \"Chevrolet Impala (Sterling Silver)\",\n    title: \"Alloy Rim Face & Spoke Scrubbing\",\n    description: \"Detailed hand scrubbing of the front alloy spokes and rim contours to rinse away gray brake dust.\",\n    completedPoints: [\n      \"Hand scrubbed alloy wheel face spokes with specialized soft wheel brushes\",\n      \"Manual contact cleaning of tight bolt holes and front wheel rims\",\n      \"Thoroughly rinsed away surface road film and dark brake dust residuals\"\n    ]\n  },\n  {\n    id: \"impala_tire_dress\",\n    src: \"/IMG_7813.jpeg\",\n    category: \"Exterior\",\n    vehicle: \"Chevrolet Impala (Sterling Silver)\",\n    title: \"Sidewall Cleanse & Tire Dressing\",\n    description: \"Deep manual tire wash and application of premium tire dressing for a protective satin dark look.\",\n    completedPoints: [\n      \"Washed down brown outer rubber road dirt with dedicated hand sponges\",\n      \"Applied premium tire and plastic dressing for lasting UV weather defense\",\n      \"Restored deep rich black appearance to wheel sidewall rubber without sling\"\n    ]\n  },\n  {\n    id: \"impala_paint_wash\",\n    src: \"/IMG_7815.jpeg\",\n    category: \"Exterior\",\n    vehicle: \"Chevrolet Impala (Sterling Silver)\",\n    title: \"Driveway Exterior Paint Wash Finish\",\n    description: \"Manual dual-bucket exterior hand wash of painted side panels.\",\n    completedPoints: [\n      \"Full foam cannon pre-soak coverage to lift surface dirt safetly\",\n      \"Gentle manual contact hand wash of painted roof and door sections\",\n      \"Thoroughly dried with soft microfibers to prevent water spots\"\n    ]\n  },\n  {\n    id: \"edge_paint_reflect\",\n    src: \"/IMG_0648.jpeg\",\n    category: \"Exterior\",\n    vehicle: \"Ford Edge (Magnetic Metallic)\",\n    title: \"Showroom Mirror Paint Finish\",\n    description: \"Delivering a mirror-like paint wash and hand dry. The hood acts as a mirror showing clear driveway clouds.\",\n    completedPoints: [\n      \"Foam cannon pre-soak and gentle touch-safe hand wash using microfiber mitts\",\n      \"Careful microfiber dry to completely separate water spots and swirls\",\n      \"Finished with hand-applied paint sealant gloss protector for high-glaze reflection\"\n    ]\n  },\n  {\n    id: \"edge_carpet_floor\",\n    src: \"/IMG_0663.jpeg\",\n    category: \"Interior\",\n    vehicle: \"Ford Edge (Charcoal Grey)\",\n    title: \"Footwell Vacuuming & Sill Reset\",\n    description: \"Full vacuuming of the front seat footwells, seat slider rails, and doors sill margins.\",\n    completedPoints: [\n      \"Meticulous vacuum of floor carpets and passenger fabric mats\",\n      \"Wiped dirt from scuff-prone door sill guards and sliding seat metal runners\",\n      \"Ensured a lint-free, dust-free carpet look with zero left-behind gravel\"\n    ]\n  }\n];\n\nexport default function BeforeAfter() {\n  const [activeIdx, setActiveIdx] = useState(0);\n\n  const currentPhoto = SHOWCASE_PHOTOS[activeIdx];\n\n  const handleNext = () => {\n    setActiveIdx((prev) => (prev + 1) % SHOWCASE_PHOTOS.length);\n  };\n\n  const handlePrev = () => {\n    setActiveIdx((prev) => (prev - 1 + SHOWCASE_PHOTOS.length) % SHOWCASE_PHOTOS.length);\n  };\n\n  return (\n    <div className=\"flex flex-col items-center select-none font-sans max-w-5xl mx-auto w-full py-4\">\n      \n      {/* Title Header Frame */}\n      <div className=\"text-center mb-8 max-w-xl mx-auto\">\n        <span className=\"text-amber-800 font-bold font-mono text-[10px] tracking-widest uppercase block mb-1\">\n          \342\230\205 EXCLUSIVE WORK SHOWCASE \342\230\205\n        </span>\n        <h3 className=\"text-3xl sm:text-4xl font-serif font-black text-[#2e261f] tracking-tight\">\n          Cobb County Driveway Results\n        </h3>\n        <p className=\"text-[#5c544a] text-xs sm:text-sm mt-2 leading-relaxed font-semibold\">\n          No stock photos, no digital filters, and no made-up comparisons. Click through these 13 genuine pictures taken immediately after detailing jobs in our local neighborhood driveway. \n        </p>\n      </div>\n\n      {/* Main Single-View Interactive Inspector Frame */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch w-full\">\n        \n        {/* Left Column: Interactive Image Frame with Arrows */}\n        <div className=\"lg:col-span-7 flex flex-col justify-between space-y-4\">\n          \n          <div className=\"relative w-full aspect-[16/11] sm:aspect-[16/10] overflow-hidden border-4 border-[#2e261f] shadow-2xl bg-neutral-900\"\n            style={{ borderRadius: \"24px 4px 24px 4px\" }}\n          >\n            {/* The Image View Frame */}\n            <div className=\"absolute inset-0 w-full h-full flex items-center justify-center\">\n              <img\n                src={currentPhoto.src}\n                alt={currentPhoto.title}\n                className=\"w-full h-full object-cover transition-all duration-300 pointer-events-none select-none\"\n                referrerPolicy=\"no-referrer\"\n              />\n              \n              {/* Image Label Stamp */}\n              <div className=\"absolute top-4 left-4 bg-zinc-950/90 border border-zinc-700 text-[#faf8f5] font-mono text-[9px] font-bold px-3 py-1 cursor-default tracking-widest uppercase\"\n                style={{ borderRadius: \"4px 1px 4px 1px\" }}\n              >\n                Photo {activeIdx + 1} of {SHOWCASE_PHOTOS.length}\n              </div>\n\n              {/* Status Watermark */}\n              <div className=\"absolute bottom-4 right-4 bg-[#fff9e6] border border-amber-400 text-[#92400e] font-mono font-black text-[9px] px-3 py-1 cursor-default tracking-widest uppercase\"\n                style={{ borderRadius: \"4px 1px 4px 1px\" }}\n              >\n                \342\230\205 Finished Driveway Detail\n              </div>\n            </div>\n\n            {/* Previous Arrow Cover */}\n            <button\n              onClick={handlePrev}\n              className=\"absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/90 hover:bg-white text-[#2e261f] border-2 border-[#2e261f] flex items-center justify-center hover:scale-105 active:scale-95 transition-all cursor-pointer shadow-md\"\n              style={{ borderRadius: \"50%\" }}\n              title=\"Previous Photo\"\n            >\n              <ChevronLeft className=\"w-5 h-5 stroke-[3]\" />\n            </button>\n\n            {/* Next Arrow Cover */}\n            <button\n              onClick={handleNext}\n              className=\"absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/90 hover:bg-white text-[#2e261f] border-2 border-[#2e261f] flex items-center justify-center hover:scale-105 active:scale-95 transition-all cursor-pointer shadow-md\"\n              style={{ borderRadius: \"50%\" }}\n              title=\"Next Photo\"\n            >\n              <ChevronRight className=\"w-5 h-5 stroke-[3]\" />\n            </button>\n          </div>\n\n          {/* Simple Image Selector Indicator strip (No confusing categories/angles tabs) */}\n          <div className=\"flex items-center justify-between bg-[#fbf9f6] border-2 border-[#e6dccf] p-3 rounded-xl\">\n            <span className=\"text-[10px] font-mono text-zinc-500 font-bold uppercase tracking-wider block truncate max-w-[180px] sm:max-w-xs\">\n              {currentPhoto.vehicle}\n            </span>\n            \n            <span className=\"text-[10px] font-mono text-amber-800 font-extrabold uppercase tracking-widest\">\n              [ Tap Thumbnails Below to Browse ]\n            </span>\n          </div>\n\n        </div>\n\n        {/* Right Column: Specifications Detail Frame */}\n        <div className=\"lg:col-span-5 bg-white border-2 border-[#e6dccf] p-6 text-left flex flex-col justify-between space-y-6\"\n          style={{ borderRadius: \"24px 4px 24px 4px\" }}\n        >\n          <div className=\"space-y-4\">\n            \n            {/* Headers describing what is in this photo */}\n            <div className=\"space-y-1.5 text-left\">\n              <span className=\"bg-amber-100 text-[#b45309] font-mono font-bold text-[9px] sm:text-[10px] px-2.5 py-0.5 border border-amber-300 uppercase tracking-widest block w-fit rounded\">\n                Tier: {currentPhoto.category} Detail\n              </span>\n              <h4 className=\"text-xl sm:text-2xl font-serif font-black text-[#2e261f] leading-tight pt-1\">\n                {currentPhoto.title}\n              </h4>\n              <p className=\"text-[#5c544a] text-xs leading-relaxed font-serif italic mt-1 font-semibold\">\n                \"{currentPhoto.description}\"\n              </p>\n            </div>\n\n            {/* Divider line */}\n            <div className=\"h-[2px] bg-gradient-to-r from-amber-600/30 via-amber-650/10 to-transparent shadow-sm\" />\n\n            {/* Hand-detailed completed checkpoints (only from the services menu) */}\n            <div className=\"space-y-2\">\n              <span className=\"text-[10px] font-mono font-black uppercase tracking-widest text-[#b45309] block\">\n                COMPLETED HAND DETAIL POINTS\n              </span>\n              <ul className=\"space-y-2.5\">\n                {currentPhoto.completedPoints.map((point, index) => (\n                  <li key={index} className=\"flex items-start gap-2 text-xs text-[#2e261f] font-semibold leading-relaxed\">\n                    <Check className=\"w-3.5 h-3.5 text-amber-700 shrink-0 mt-0.5\" />\n                    <span>{point}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n\n          </div>\n\n          {/* Simple Crew signature block */}\n          <div className=\"space-y-4 border-t border-dashed border-[#e6dccf] pt-4\">\n            <div className=\"flex items-center justify-between text-[11px] font-mono font-bold text-zinc-500 bg-neutral-50 px-3 py-2.5 rounded-lg border\">\n              <span className=\"flex items-center gap-1.5\">\n                <Sparkles className=\"w-3.5 h-3.5 text-amber-500 animate-pulse\" />\n                No Machine Polishing\n              </span>\n              <span className=\"text-amber-850\">Arthur & Carson</span>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* Thumbnails Row Scroller (Simple, elegant clickable bar) */}\n      <div className=\"w-full mt-6 bg-[#f5efe6] p-2.5 border-2 border-[#e6dccf] rounded-2xl flex items-center justify-start gap-2 overflow-x-auto whitespace-nowrap scrollbar-thin scrollbar-thumb-amber-800 scrollbar-track-neutral-50\">\n        {SHOWCASE_PHOTOS.map((photo, index) => {\n          const isActive = index === activeIdx;\n          return (\n            <button\n              key={photo.id}\n              onClick={() => setActiveIdx(index)}\n              className={`relative inline-block w-16 h-12 flex-shrink-0 cursor-pointer overflow-hidden border-2 transition-all duration-150 ${\n                isActive \n                  ? \"border-[#b45309] ring-2 ring-amber-500/30 scale-105\" \n                  : \"border-[#e6dccf] hover:border-zinc-500\"\n              }`}\n              style={{ borderRadius: \"6px 1.5px 6px 1.5px\" }}\n              title={photo.title}\n            >\n              <img\n                src={photo.src}\n                alt={photo.title}\n                className=\"w-full h-full object-cover\"\n                referrerPolicy=\"no-referrer\"\n              />\n              {/* Active check overlay indicator */}\n              {isActive && (\n                <div className=\"absolute inset-0 bg-black/30 flex items-center justify-center\">\n                  <Check className=\"w-4 h-4 text-white stroke-[3.5]\" />\n                </div>\n              )}\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Clean quiet promise section */}\n      <div className=\"w-full mt-6 flex items-center gap-2 bg-[#fdfaf2] border border-[#f5ebcf] p-3 text-[11px] text-[#854d0e] font-serif font-semibold\"\n        style={{ borderRadius: \"10px 2px 10px 2px\" }}\n      >\n        <AlertCircle className=\"w-4 h-4 text-amber-700 shrink-0\" />\n        <span>\n          <strong>Neighbor Cleanliness Promise:</strong> We complete all contact exterior washes and vacuuming with zero noisy heavy equipment. We connect to exactly one garden hose water spigot and one 110V driveway wall outlet to keep your street quiet.\n        </span>\n      </div>\n\n    </div>\n  );\n}\n"
    }

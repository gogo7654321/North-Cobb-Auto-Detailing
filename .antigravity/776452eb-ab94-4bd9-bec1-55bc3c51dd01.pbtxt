    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState } from \"react\";\nimport { Check, Sparkles, AlertCircle, ArrowLeftRight, HelpCircle, Layers } from \"lucide-react\";\n\ninterface ImpalaZone {\n  id: string;\n  name: string;\n  category: \"Interior\" | \"Exterior\" | \"Full Detailing\";\n  photoA: string;\n  photoB: string;\n  titleA: string;\n  titleB: string;\n  caption: string;\n  completedPoints: string[];\n  specs: { label: string; value: string }[];\n}\n\nconst IMPALA_ZONES: ImpalaZone[] = [\n  {\n    id: \"dash_console\",\n    name: \"Dashboard & Console\",\n    category: \"Interior\",\n    photoA: \"/IMG_7825.jpeg\",\n    photoB: \"/IMG_7826.jpeg\",\n    titleA: \"Center Console Console & Dash Profile\",\n    titleB: \"Instrument Panel & Dial Crevice Finish\",\n    caption: \"Deep interior wipe down of all high-touch panels, gloveboxes, storage compartments, and console crevices.\",\n    completedPoints: [\n      \"Wiped down all dashboard trim, steering column outer plastics, and center console surfaces\",\n      \"Cleared out crumbs, dust, and sticky residues from cup holders and gear shifts by hand\",\n      \"Meticulous crevice work to lift built-up dust from climate control vents and dial teeth\",\n      \"Satin-matte finish with premium surface dressing\342\200\224no greasy artificial shine\"\n    ],\n    specs: [\n      \"Process: Standard hand-wipe detailing\",\n      \"Applicator: Specialized soft microfibers\",\n      \"Dressing: Non-greasy UV trim protector\"\n    ]\n  },\n  {\n    id: \"carpets_floor\",\n    name: \"Carpets & Floor Care\",\n    category: \"Interior\",\n    photoA: \"/IMG_7827.jpeg\",\n    photoB: \"/IMG_7828.jpeg\",\n    titleA: \"Driver Footwell Heavy Pile Cleansing\",\n    titleB: \"Passenger Footwell Deep Pile Restore\",\n    caption: \"Full thorough vacuuming of seats, carpets, and tight floor track sections with deep mat restoration.\",\n    completedPoints: [\n      \"Complete deep vacuum of all floor wells, seats, and door sill corners\",\n      \"Removal of embedded soil, dried mud, and travel debris from fabric fibers\",\n      \"Scrubbed down and restored rubber weather mats to factory-clean black\",\n      \"Hand detailing around seat mounting pins and sliding tracks\"\n    ],\n    specs: [\n      \"Vacuum Style: Dual-flow commercial vacuum\",\n      \"Mat Service: Manual deep scrubbing\",\n      \"Fibers: Thick synthetic dense pile\"\n    ]\n  },\n  {\n    id: \"trunk_cargo\",\n    name: \"Trunk & Cargo Rest\",\n    category: \"Interior\",\n    photoA: \"/IMG_7829.jpeg\",\n    photoB: \"/IMG_7830.jpeg\",\n    titleA: \"Cargo Space Cleanse Angle 1\",\n    titleB: \"Trunk Deck Fabric Restore Angle 2\",\n    caption: \"Full cargo area vacuum extraction, cleaning the trunk liner, spare tire lid, and tight velour corners.\",\n    completedPoints: [\n      \"Thorough high-force vacuum of rear luggage compartment and side walls\",\n      \"Lifting of persistent debris, plant matter, and embedded sand from tight weaves\",\n      \"Detailed cleaning of cargo tie-downs and the spare tire lid handle\",\n      \"Upholstery grooming leaving fibers uniformly cleaned and fresh\"\n    ],\n    specs: [\n      \"Process: Complete cargo vacuuming\",\n      \"Attention Level: Tight seam border folds\",\n      \"Goal: Rescued floor surface appearance\"\n    ]\n  },\n  {\n    id: \"door_jambs\",\n    name: \"Door Panels & Jambs\",\n    category: \"Exterior\",\n    photoA: \"/IMG_7837.jpeg\",\n    photoB: \"/IMG_7838.jpeg\",\n    titleA: \"Door jamb Edge & Weather Strip Prep\",\n    titleB: \"Inner Door Panel Threshold Detail\",\n    caption: \"Wiping clean the door frames, thresholds, and hinge recesses from dirt, spray, and hand oils.\",\n    completedPoints: [\n      \"Removed baked-on grime, water spots, and pollen crust from painted door jamb borders\",\n      \"Wiped down inner door card panels, pocket recesses, and pull handles\",\n      \"Cleaned hinge weather seals and drain channels to prevent dirty run-offs\",\n      \"Restored painted jamb threshold edges to match the outer showroom gloss\"\n    ],\n    specs: [\n      \"Wipe style: Clean microfiber contact wash\",\n      \"Technique: Detailing brush & damp wipes\",\n      \"Finished: High-gloss paint wipe\"\n    ]\n  },\n  {\n    id: \"alloy_wheels\",\n    name: \"Alloy Wheels & Tires\",\n    category: \"Exterior\",\n    photoA: \"/IMG_7812.jpeg\",\n    photoB: \"/IMG_7813.jpeg\",\n    titleA: \"Alloy Wheel Rim & Spoke Scrub\",\n    titleB: \"Tire Face & Dressing Gloss Detail\",\n    caption: \"Deep hand scrubbing of the wheels, inner rim spokes, and applying tire dress for UV protection.\",\n    completedPoints: [\n      \"Wheels, tires, and rims thoroughly scrubbed to remove road dust and grime\",\n      \"Manual cleaning of alloy spokes and wheel face contours to clear gray brake powder\",\n      \"Hand washed tire sidewalls to strip away dirt layers and brown discoloration\",\n      \"Applied premium tire and plastic dressing for a rich, hydrated black tire look with UV defense\"\n    ],\n    specs: [\n      \"Scrub style: Manual wheel brush + wash mitt\",\n      \"Protectant: Premium tire & plastic dressing\",\n      \"Result: Long-lasting deep black shine\"\n    ]\n  }\n];\n\nexport default function BeforeAfter() {\n  const [activeZoneIdx, setActiveZoneIdx] = useState(0);\n  const [selectedAngle, setSelectedAngle] = useState<\"A\" | \"B\">(\"A\");\n\n  const currentZone = IMPALA_ZONES[activeZoneIdx];\n\n  const handleZoneChange = (idx: number) => {\n    setActiveZoneIdx(idx);\n    setSelectedAngle(\"A\"); // Default to Angle A on switch\n  };\n\n  return (\n    <div className=\"flex flex-col items-center select-none font-sans max-w-5xl mx-auto w-full py-4\">\n      \n      {/* Title Header Frame */}\n      <div className=\"text-center mb-8 max-w-xl mx-auto\">\n        <span className=\"text-amber-800 font-bold font-mono text-[10px] tracking-widest uppercase block mb-1\">\n          \342\230\205 CASE STUDY INSIGHT \342\230\205\n        </span>\n        <h3 className=\"text-3xl sm:text-4xl font-serif font-black text-[#2e261f] tracking-tight\">\n          Chevrolet Impala Showroom Showcase\n        </h3>\n        <p className=\"text-[#5c544a] text-xs sm:text-sm mt-2 leading-relaxed font-semibold\">\n          Explore actual photos taken after our most recent driveway detail. Use the panels to inspect how Arthur and Carson restore different areas to their absolute best using only our standard equipment.\n        </p>\n      </div>\n\n      {/* Zone Navigator Grid */}\n      <div className=\"flex flex-wrap items-center justify-center gap-2 mb-8 bg-[#f5efe6] p-2 border-2 border-[#e6dccf] w-full max-w-4xl rounded-2xl\">\n        {IMPALA_ZONES.map((zone, idx) => (\n          <button\n            key={zone.id}\n            onClick={() => handleZoneChange(idx)}\n            className={`px-4 py-2.5 text-[10px] sm:text-xs font-black uppercase tracking-wider transition-all duration-150 cursor-pointer rounded-lg ${\n              activeZoneIdx === idx\n                ? \"bg-[#b45309] text-white shadow-sm font-black\"\n                : \"text-[#5c544a] hover:bg-[#e6dccf]/50 hover:text-zinc-900\"\n            }`}\n            style={{ borderRadius: \"10px 2.5px 10px 2.5px\" }}\n          >\n            {zone.name}\n          </button>\n        ))}\n      </div>\n\n      {/* Main Interactive Viewer Frame */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch w-full\">\n        \n        {/* Left Column: Interactive Image Frame with Angle Toggle */}\n        <div className=\"lg:col-span-7 flex flex-col justify-between space-y-4\">\n          \n          <div className=\"relative w-full aspect-[16/10] overflow-hidden border-4 border-[#2e261f] shadow-2xl bg-neutral-900\"\n            style={{ borderRadius: \"24px 4px 24px 4px\" }}\n          >\n            {/* The Image View Frame */}\n            <div className=\"absolute inset-0 w-full h-full\">\n              <img\n                src={selectedAngle === \"A\" ? currentZone.photoA : currentZone.photoB}\n                alt={selectedAngle === \"A\" ? currentZone.titleA : currentZone.titleB}\n                className=\"w-full h-full object-cover transition-all duration-300 pointer-events-none select-none\"\n                referrerPolicy=\"no-referrer\"\n              />\n              \n              {/* Image Label Stamp */}\n              <div className=\"absolute top-4 left-4 bg-zinc-950/90 border border-zinc-700 text-[#faf8f5] font-mono text-[9px] font-bold px-3 py-1 cursor-default tracking-widest uppercase\"\n                style={{ borderRadius: \"4px 1px 4px 1px\" }}\n              >\n                {selectedAngle === \"A\" ? \"Angle A: Finished Detail\" : \"Angle B: Finished Detail\"}\n              </div>\n\n              {/* Status Watermark */}\n              <div className=\"absolute bottom-4 right-4 bg-[#fff9e6] border border-amber-400 text-[#92400e] font-mono font-black text-[9px] px-3 py-1 cursor-default tracking-widest uppercase\"\n                style={{ borderRadius: \"4px 1px 4px 1px\" }}\n              >\n                \342\230\205 Real Client Showcase\n              </div>\n            </div>\n          </div>\n\n          {/* Quick Interactive Angle Swapper */}\n          <div className=\"flex items-center justify-between bg-[#fbf9f6] border-2 border-[#e6dccf] p-3 rounded-xl\">\n            <span className=\"text-[10px] font-mono text-zinc-500 font-bold uppercase tracking-wider\">\n              {selectedAngle === \"A\" ? currentZone.titleA : currentZone.titleB}\n            </span>\n            \n            <div className=\"flex gap-1.5 shrink-0 select-none\">\n              <button\n                onClick={() => setSelectedAngle(\"A\")}\n                className={`px-3.5 py-1.5 text-[10px] font-extrabold tracking-widest uppercase transition-all duration-150 cursor-pointer rounded-md ${\n                  selectedAngle === \"A\"\n                    ? \"bg-[#2e261f] text-[#fffdfb] font-black\"\n                    : \"text-[#5c544a] bg-neutral-100 hover:bg-neutral-200\"\n                }`}\n                style={{ borderRadius: \"6px 1.5px 6px 1.5px\" }}\n              >\n                View Angle A\n              </button>\n              <button\n                onClick={() => setSelectedAngle(\"B\")}\n                className={`px-3.5 py-1.5 text-[10px] font-extrabold tracking-widest uppercase transition-all duration-150 cursor-pointer rounded-md ${\n                  selectedAngle === \"B\"\n                    ? \"bg-[#2e261f] text-[#fffdfb] font-black\"\n                    : \"text-[#5c544a] bg-neutral-100 hover:bg-neutral-200\"\n                }`}\n                style={{ borderRadius: \"6px 1.5px 6px 1.5px\" }}\n              >\n                View Angle B\n              </button>\n            </div>\n          </div>\n\n        </div>\n\n        {/* Right Column: Custom Specifications Panel (No AI-slop) */}\n        <div className=\"lg:col-span-5 bg-white border-2 border-[#e6dccf] p-6 text-left flex flex-col justify-between space-y-6\"\n          style={{ borderRadius: \"24px 4px 24px 4px\" }}\n        >\n          <div className=\"space-y-4\">\n            {/* Headers */}\n            <div className=\"space-y-1.5\">\n              <span className=\"bg-amber-100 text-[#b45309] font-mono font-bold text-[9px] sm:text-[10px] px-2.5 py-0.5 border border-amber-300 uppercase tracking-widest block w-fit rounded\">\n                Zone: {currentZone.name}\n              </span>\n              <h4 className=\"text-xl sm:text-2xl font-serif font-black text-[#2e261f] leading-tight pt-1\">\n                Impala {currentZone.name} Reset\n              </h4>\n              <p className=\"text-[#5c544a] text-xs leading-relaxed font-serif italic mt-1 font-semibold\">\n                \"{currentZone.caption}\"\n              </p>\n            </div>\n\n            {/* Micro Divider */}\n            <div className=\"h-[2px] bg-gradient-to-r from-amber-600/30 via-amber-650/10 to-transparent\" />\n\n            {/* Checkpoints completed using only standard service equipment */}\n            <div className=\"space-y-2\">\n              <span className=\"text-[10px] font-mono font-black uppercase tracking-widest text-[#b45309] block\">\n                COMPLETED SPEC WORKS\n              </span>\n              <ul className=\"space-y-2.5\">\n                {currentZone.completedPoints.map((point, pIdx) => (\n                  <li key={pIdx} className=\"flex items-start gap-2 text-xs text-[#2e261f] font-semibold leading-relaxed\">\n                    <Check className=\"w-3.5 h-3.5 text-amber-700 shrink-0 mt-0.5\" />\n                    <span>{point}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          </div>\n\n          {/* Fact Block & Signature footer */}\n          <div className=\"space-y-4 border-t border-dashed border-[#e6dccf] pt-4\">\n            <div className=\"flex flex-wrap gap-2 justify-between text-[10px] font-mono font-bold text-zinc-550 bg-neutral-50 px-3 py-2 border rounded-lg\">\n              {currentZone.specs.map((item, key) => (\n                <div key={key} className=\"flex gap-1\">\n                  <span className=\"text-zinc-400 font-extrabold\">{item.split(\":\")[0]}:</span>\n                  <span className=\"text-[#2e261f] font-black\">{item.split(\":\")[1]}</span>\n                </div>\n              ))}\n            </div>\n\n            <div className=\"flex items-center justify-between text-[11px] font-mono font-bold text-zinc-500\">\n              <span className=\"flex items-center gap-1.5\">\n                <Sparkles className=\"w-3.5 h-3.5 text-amber-500 animate-pulse\" />\n                Handcraft Detail Done Right\n              </span>\n              <span className=\"text-amber-850\">Arthur & Carson</span>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* No Magic/AI Disclaimer notice */}\n      <div className=\"w-full mt-6 flex items-center gap-2 bg-[#fdfaf2] border border-[#f5ebcf] p-3 text-[11px] text-[#854d0e] font-serif font-semibold\"\n        style={{ borderRadius: \"10px 2px 10px 2px\" }}\n      >\n        <AlertCircle className=\"w-4 h-4 text-amber-700 shrink-0\" />\n        <span>\n          <strong>Neighbor Cleanliness Promise:</strong> We complete all exterior contact washes and deep vacuuming by hand. We cleanly tap into exactly one garden water spigot and one 110V wall outlet at your curb, so your yard remains peaceful and quiet.\n        </span>\n      </div>\n\n    </div>\n  );\n}\n"
    }
